<!DOCTYPE html>
<html lang="en">
<head>
    <title>Rooms</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2DC84D;
        }

        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: calc(100vh - 44px);
        }

        .card {
            border: 3px solid #2DC84D;
            border-radius: 20px;
            padding: 50px 80px;
            text-align: center;
        }

        .title {
            font-size: 28px;
            font-weight: bold;
            color: white;
            margin-bottom: 30px;
        }

        .btn-room {
            display: block;
            width: 220px;
            padding: 14px;
            margin: 12px auto;
            font-size: 18px;
            font-weight: bold;
            background-color: black;
            color: #2DC84D;
            border: 2px solid #2DC84D;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-room:hover {
            background-color: #2DC84D;
            color: black;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }

        .logout-btn {
            color: white;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: calc(100vh - 44px);
        }

        .card {
            border: 3px solid #d33469;
            border-radius: 20px;
            padding: 50px 80px;
            text-align: center;
        }

        .title {
            font-size: 28px;
            font-weight: bold;
            color: black;
            margin-bottom: 30px;
        }

        .btn-room {
            display: block;
            width: 220px;
            padding: 14px;
            margin: 12px auto;
            font-size: 18px;
            font-weight: bold;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-room:hover {
            background-color: #b02a57;
            color: white;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <a href="/quit-game" style="color: black; text-decoration: none; font-weight: bold;">Quit</a>
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">
        <div class="card">
            <div class="title">Pick a room to enter!</div>
            <form method="post" action="/rooms-pick/{{ gameId }}">
                <button type="submit" name="room" value="A" class="btn-room">Room A</button>
                <button type="submit" name="room" value="B" class="btn-room">Room B</button>
                <button type="submit" name="room" value="C" class="btn-room">Room C</button>
            </form>
        </div>
    </div>

    <script>
        let timeLeft = 30;

        const countdown = setInterval(() => {
            timeLeft--;

            if (timeLeft <= 0) {
                clearInterval(countdown);
                const rooms = ["A", "B", "C"];
                const randomRoom = rooms[Math.floor(Math.random() * 3)];
                const form = document.createElement("form");
                form.method = "POST";
                form.action = "/rooms-pick/{{ gameId }}";
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "room";
                input.value = randomRoom;
                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        }, 1000);
    </script>
</body>
</html>