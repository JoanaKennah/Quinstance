<!DOCTYPE html>
<html lang="en">
<head>
    <title>Play Quiz for Client</title>

    <script>
        <!--- ALL OF THIS IS JUST TO TEST HOW WEBSOCKETS WORK :) --->
        let serverURL;
        let socket;

        function setupSocket() {
            serverURL = 'ws://127.0.0.1:8080/gameServer';
            socket = new WebSocket(serverURL);

            socket.onopen = logOpenToConsole;
            socket.onclose = logCloseToConsole;
            socket.onmessage = retrieveQuestion;
        }

        function logOpenToConsole() {
            console.log("Web socket connection opened");
        }

        function logCloseToConsole() {
            console.log("Web socket connection closed");
        }

        function retrieveQuestion(event) {
            let questionData = JSON.parse(event.data);
            console.log(`Retrieved question: ${questionData.questionText}`);
            console.log(`Retrieved answers: ${questionData.answerOne}, ${questionData.answerTwo}, ${questionData.answerThree}, ${questionData.answerFour} `);

            document.getElementById('questionNum').innerHTML = "Question " + questionData.questionNumber + ":";
            document.getElementById('questionText').innerHTML = questionData.questionText;

            document.getElementById('answer-0').innerHTML = questionData.answerOne;
            document.getElementById('answer-1').innerHTML = questionData.answerTwo;
            document.getElementById('answer-2').innerHTML = questionData.answerThree;
            document.getElementById('answer-3').innerHTML = questionData.answerFour;
        }

        function buildAnswer(name, answer) {
            let data = {
                username: name,
                chosenAnswer: answer,
            };
            sendAnswerViaSocket(data);
        }

        function sendAnswerViaSocket(data) {
            socket.send(JSON.stringify(data));
        }

    </script>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }
 
        .question-title {
            color: black;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .question-box {
            border: 4px solid #e63973;
            background-color: white;
            color: black;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            font-size: 20px;
        }

        .answers {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
        }

        .column {
            width: 45%;
        }

        .answer-btn {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }
      
        .answer-btn:hover {
            background-color: #e63973;
            color: white;
        }

        .answer-btn.selected {
            background-color: #e63973;
            color: white;
        }
    </style>

    <script>
        let timeleft = 30;

        function startTimer() {
            const countdown = setInterval(() => {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    <!--- ROUTE TO NEXT PAGE --->
                }
            }, 1000)
        }

        function selectAnswer(index) {
            <!--- to stop multiple clicks and traffic --->
            const buttons = document.querySelectorAll(".answer-btn");
            buttons.forEach(btn => btn.disabled = true);

            const selected = document.getElementById("answer-" + index);
            selected.classList.add("selected");

            setTimeout(() => {}, 500); <!--- NEED TO ADD ROUTING --->

            buildAnswer("{{ username }}", selected.innerHTML)
        }

        window.onload = startTimer;
    </script>

</head>

<body onload='javascript:setupSocket()'>

<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="question-title">
        <div id=questionNum></div>
    </div>

    <div class="question-box">
        <div id=questionText></div>
    </div>

    <div class="answers">

        <div class="column">
            <button id="answer-0" class="answer-btn"
                onclick="selectAnswer(0)">
            </button>
            <button id="answer-2" class="answer-btn"
                onclick="selectAnswer(2)">
            </button>
        </div>

        <div class="column">
            <button id="answer-1" class="answer-btn"
                onclick="selectAnswer(1)">
            </button>
            <button id="answer-3" class="answer-btn"
                onclick="selectAnswer(3)">
            </button>
        </div>
    </div>
</div>

</body>
</html>