<!DOCTYPE html>
<html lang="en">
<head>
    <title>Play Quiz for Client</title>

    <script>
        //ALL OF THIS IS JUST TO TEST HOW WEBSOCKETS WORK
        let serverURL;
        let socket;
        let answered = false;

        function setupSocket() {
            const protocol = location.protocol === "https:" ? "wss:" : "ws:";
            socket = new WebSocket(protocol + "//" + location.host + "/game/{{ gameId }}");

            socket.onopen = logOpenToConsole;
            socket.onclose = logCloseToConsole;
            socket.onmessage = retrieveQuestion;
        }

        function logOpenToConsole() {
            console.log("Web socket connection opened");
        }

        function logCloseToConsole() {
            console.log("Web socket connection closed");
        }

        function retrieveQuestion(event) {
            let data = JSON.parse(event.data);

            // check for redirect instruction
            if (data.redirect) {
                window.location.href = data.redirect;
                return;
            }

            // if not - handle as question data
            answered = false;
            console.log(`Retrieved question: ${data.questionText}`);
            console.log(`Retrieved answers: ${data.answerOne}, ${data.answerTwo}, ${data.answerThree}, ${data.answerFour} `);

            document.getElementById('questionNum').innerHTML = "Question " + data.questionNumber + ":";
            document.getElementById('questionText').innerHTML = data.questionText;

            setAnswer("answer-0", data.answerOne);
            setAnswer("answer-1", data.answerTwo);
            setAnswer("answer-2", data.answerThree);
            setAnswer("answer-3", data.answerFour);
        }

        function buildAnswer(name, answer) {
            let data = {
                username: name,
                chosenAnswer: answer,
            };
            sendAnswerViaSocket(data);
        }

        function sendAnswerViaSocket(data) {
            socket.send(JSON.stringify(data));
        }

        function setAnswer(id, text) {
            const btn = document.getElementById(id);
            if (text) {
                btn.textContent = text;
                btn.style.display = "block";
            } else {
                btn.style.display = "none";
            }
        }

    </script>

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
        }
        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }
        .content {
            margin: 40px;
            text-align: center;
        }
        .question-title {
            color: #2DC84D;
            font-size: 28px;
            margin-bottom: 20px;
        }
        .question-box {
            border: 4px solid #2DC84D;
            background-color: black;
            color: #2DC84D;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            font-size: 20px;
        }
        .answers {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
        }
        .column {
            width: 45%;
        }
        .answer-btn {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            background-color: black;
            color: #2DC84D;
            border: 2px solid #2DC84D;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }
        .answer-btn:hover {
            background-color: #2DC84D;
            color: black;
        }
        .answer-btn.selected {
            background-color: #2DC84D;
            color: black;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }
 
        .question-title {
            color: black;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .question-box {
            border: 4px solid #e63973;
            background-color: white;
            color: black;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            font-size: 20px;
        }

        .answers {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
        }

        .column {
            width: 45%;
        }

        .answer-btn {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }
      
        .answer-btn:hover {
            background-color: #e63973;
            color: white;
        }

        .answer-btn.selected {
            background-color: #e63973;
            color: white;
        }
    </style>
    {% endif %}

    <script>
        let timeLeft = 30;

        function startTimer() {
            const countdown = setInterval(() => {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    //checks player hasn't clicked to avoid a dupe answer
                    if (!answered) {                            
                        answered = true;
                        //sends empty string as answer
                        buildAnswer("{{ username }}", "");
                    }
                }
            }, 1000)
        }

        function selectAnswer(index) {
            //to stop multiple clicks and traffic --->
            if (answered) return;
            answered = true;
            localStorage.removeItem("quizEndTime");                         //clear old timer

            const buttons= document.querySelectorAll(".answer-btn");
            buttons.forEach(btn => btn.disabled = true);

            const selected = document.getElementById("answer-" + index);
            selected.classList.add("selected");

            const selectedText = selected.textContent.trim();

            buildAnswer("{{ username }}", selectedText);

            //take user towaiting screen showing selected answer, handles special characters
            window.location.href = "/selected-answer/{{ gameId }}?answer=" + encodeURIComponent(selectedText);
        }

    </script>

</head>

<body onload='setupSocket(); startTimer();'>

<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="question-title">
        <div id=questionNum></div>
    </div>

    <div class="question-box">
        <div id=questionText></div>
    </div>

    <div class="answers">

        <div class="column">
            <button id="answer-0" class="answer-btn"
                onclick="selectAnswer(0)">
            </button>
            <button id="answer-2" class="answer-btn"
                onclick="selectAnswer(2)">
            </button>
        </div>

        <div class="column">
            <button id="answer-1" class="answer-btn"
                onclick="selectAnswer(1)">
            </button>
            <button id="answer-3" class="answer-btn"
                onclick="selectAnswer(3)">
            </button>
        </div>
    </div>
</div>

</body>
</html>