<!DOCTYPE html>
<html lang="en">
<head>
    <title>Maths Result</title>
    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2dc84d;
        }

        .navbar {
            background-color: #2dc84d;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 30px;
        }

        .title-box {
            border: 2px solid #2dc84d;
            border-radius: 10px;
            padding: 15px 25px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: black;
            color: #2dc84d;
            border: 2px solid #2dc84d;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #2dc84d;
            color: black;
        }

        .message {
            font-size: 22px;
            margin-bottom: 30px;
        }

        .loser {
            font-size: 36px;
            font-weight: bold;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .result-row {
            display: flex;
            align-items: flex-start;
            justify-content: flex-start;
            gap: 40px;
            margin-top: 20px;
            text-align: left;
        }

        .ghost-icon {
            flex-shrink: 0;
        }

        .ghost-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 30px;
        }

        .title-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px 25px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #e63973;
            color: white;
        }

        .message {
            font-size: 22px;
            margin-bottom: 30px;
        }

        .loser {
            font-size: 36px;
            font-weight: bold;
            color: #e63973;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .result-row {
            display: flex;
            align-items: flex-start;
            justify-content: flex-start;
            gap: 40px;
            margin-top: 20px;
            text-align: left;
        }

        .ghost-icon {
            flex-shrink: 0;
        }

        .ghost-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">
        <div class="top-row">
            <div></div>

            <div class="title-box">
                <h1>Maths</h1>
            </div>

            <form method="post" action="/show-positions/{{ gameId }}">
                <button type="submit" class="btn-next">Next</button>
            </form>
        </div>

        <div class="message">
            Uh oh! You scored the least…you have now become a ghost!
        </div>

        <div class="result-row">
            <div class="ghost-icon">
                <svg width="160" height="160" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ghost">
                <title>Ghost</title>
                {% if theme == "spooky" %}
                    <path fill="white" d="M417.913,490.426c-0.385-0.138-38.763-14.23-55.472-58.08c-14.151-37.133-6.785-79.476,19.224-110.507c14.821-17.682,63.176-79.533,63.176-132.999C444.84,84.714,360.127,0,256.001,0S67.161,84.714,67.161,188.84c0,69.232,32.57,145.853,87.125,204.963c45.579,49.385,127.55,109.975,259.215,118.176c0.234,0.014,0.467,0.022,0.699,0.022c5.239,0,9.811-3.685,10.875-8.88C426.183,497.695,423.129,492.281,417.913,490.426z M170.611,378.734c-50.867-55.113-81.234-126.102-81.234-189.895c0-91.876,74.747-166.623,166.623-166.623s166.623,74.747,166.623,166.623c0,36.528-29.954,85.282-57.986,118.728c-31.175,37.196-39.972,88.039-22.957,132.689c7.327,19.227,18.055,33.74,28.872,44.473C271.864,468.026,208.092,419.344,170.611,378.734z M234.291,141.511c0-23.67-14.638-42.211-33.325-42.211c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.637,42.211,33.325,42.211C219.652,183.722,234.291,165.181,234.291,141.511z M200.966,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C212.074,152.955,206.21,161.506,200.966,161.506z M305.382,99.3c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.638,42.211,33.325,42.211s33.325-18.541,33.325-42.211C338.707,117.84,324.07,99.3,305.382,99.3z M305.382,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C316.49,152.955,310.626,161.506,305.382,161.506z M253.174,201.495c-22.356,0-40.545,18.189-40.545,40.545v32.214c0,22.356,18.189,40.545,40.545,40.545c22.355,0,40.545-18.189,40.545-40.545V242.04C293.719,219.684,275.53,201.495,253.174,201.495z M271.502,274.254c0,10.106-8.221,18.329-18.329,18.329c-10.106,0-18.329-8.222-18.329-18.329V242.04c0-10.106,8.222-18.329,18.329-18.329c10.106,0,18.329,8.222,18.329,18.329V274.254z"/>
                {% else %}
                    <path fill="#e63973" d="M417.913,490.426c-0.385-0.138-38.763-14.23-55.472-58.08c-14.151-37.133-6.785-79.476,19.224-110.507c14.821-17.682,63.176-79.533,63.176-132.999C444.84,84.714,360.127,0,256.001,0S67.161,84.714,67.161,188.84c0,69.232,32.57,145.853,87.125,204.963c45.579,49.385,127.55,109.975,259.215,118.176c0.234,0.014,0.467,0.022,0.699,0.022c5.239,0,9.811-3.685,10.875-8.88C426.183,497.695,423.129,492.281,417.913,490.426z M170.611,378.734c-50.867-55.113-81.234-126.102-81.234-189.895c0-91.876,74.747-166.623,166.623-166.623s166.623,74.747,166.623,166.623c0,36.528-29.954,85.282-57.986,118.728c-31.175,37.196-39.972,88.039-22.957,132.689c7.327,19.227,18.055,33.74,28.872,44.473C271.864,468.026,208.092,419.344,170.611,378.734z M234.291,141.511c0-23.67-14.638-42.211-33.325-42.211c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.637,42.211,33.325,42.211C219.652,183.722,234.291,165.181,234.291,141.511z M200.966,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C212.074,152.955,206.21,161.506,200.966,161.506z M305.382,99.3c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.638,42.211,33.325,42.211s33.325-18.541,33.325-42.211C338.707,117.84,324.07,99.3,305.382,99.3z M305.382,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C316.49,152.955,310.626,161.506,305.382,161.506z M253.174,201.495c-22.356,0-40.545,18.189-40.545,40.545v32.214c0,22.356,18.189,40.545,40.545,40.545c22.355,0,40.545-18.189,40.545-40.545V242.04C293.719,219.684,275.53,201.495,253.174,201.495z M271.502,274.254c0,10.106-8.221,18.329-18.329,18.329c-10.106,0-18.329-8.222-18.329-18.329V242.04c0-10.106,8.222-18.329,18.329-18.329c10.106,0,18.329,8.222,18.329,18.329V274.254z"/>
                {% endif %}
                </svg>
            </div>

            <div class="ghost-list">
                {% for ghost in ghostPlayers %}
                    <div class="loser">{{ ghost }}</div>
                {% endfor %}
            </div>
        </div>

</body>
</html>