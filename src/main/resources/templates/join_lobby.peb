<!DOCTYPE html>
<html lang="en">
<head>
    <title>Join a Lobby</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title-box {
            border: 2px solid #d33469;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 40px;
            display: inline-block;
            width: 80%;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
            color: black;
        }

        .subtitle {
            color: #d33469;
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 25px;
        }

        .code-input {
            width: 60%;
            padding: 15px;
            font-size: 20px;
            text-align: center;
            border: 2px solid #d33469;
            border-radius: 8px;
            color: #d33469;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .code-input::placeholder {
            color: #d33469;
            opacity: 0.5;
        }

        .error {
            color: #d33469;
            font-weight: bold;
            font-size: 16px;
            margin-top: 10px;
            min-height: 24px; /* keeps layout stable when no error */
        }

        .join-btn {
            display: block;
            width: 200px;
            margin: 0 auto 10px auto;
            padding: 14px;
            font-size: 18px;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
        }

        .join-btn:hover {
            background-color: #b02a57;
            color: white;
        }

        .bottom-bar {
            margin-top: 60px;
            text-align: left;
        }

        .return-btn {
            padding: 12px 22px;
            font-size: 16px;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            cursor: pointer;
            border-radius: 6px;
        }

        .return-btn:hover {
            background-color: #b02a57;
            color: white;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
    </style>
</head>

<body>

<div class="navbar">
    <a>Join a Lobby</a>
</div>

<div class="content">

    <div class="title-box">
        <h1>Join a Lobby!</h1>
    </div>

    <div class="subtitle">
        Enter 8-character Room Code below to join a quiz lobby!
    </dive>

    <label for="roomCode" class="sr-only">Room Code</label>

    <form method="post" action="/join-lobby">

        <input type="text"
               id="roomCode"
               name="roomCode"
               class="code-input"
               placeholder="Enter Room Code"
               maxlength="8"
               value="{{ roomCode }}"
               required>

        <button type="submit" class="join-btn">Join</button>

        <!-- Shows error message if code was invalid, empty otherwise -->
        <div class="error">{{ errorMessage }}</div>

    </form>

    <div class="bottom-bar">
        <button class="return-btn"
                onclick="window.location.href='{{ returnURL }}'">
            Return to Dashboard
        </button>
    </div>

</div>

</body>
</html>