<!DOCTYPE html>
<html lang="en">
<head>
    <title>Rooms</title>
    <!-- graphics from svgrepo -->
    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2DC84D;
        }

        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title-box {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
            margin-bottom: 25px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .description {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .arena {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 60px;
        }

        .door-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .countdown {
            font-size: 60px;
            font-weight: bold;
            min-height: 80px;
        }

        .spacer {
            min-height: 80px;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            color: white;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
            margin-bottom: 25px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .description {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .arena {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 60px;
        }

        .door-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .countdown {
            font-size: 60px;
            font-weight: bold;
            color: #e63973;
            min-height: 80px;
        }

        .spacer {
            min-height: 80px;
        }
    </style>
    {% endif %}
</head>

<body onload='startTimer();'>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">

        <div class="title-box">
            <h1>Rooms</h1>
        </div>

        <div class="description">
            Pick a room to enter. If everyone picks the same room, you are all safe! If not, the busiest room must be prepared for a scare!
        </div>

        <div class="arena">

            <!-- Door A -->
            <div class="door-col">
                <div class="spacer"></div>
                <!-- graphics from svgrepo -->
                <svg width="150" height="150" viewBox="-13.22 0 122.88 122.88" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#2DC84D" fill-rule="evenodd" clip-rule="evenodd" d="M0,115.27h4.39V1.99V0h1.99h82.93h1.99v1.99v113.28h5.14v7.61H0V115.27L0,115.27z M13.88,8.32H81.8h0.83v0.83 v104.89h4.69V3.97H8.36v111.3h4.69V9.15V8.32H13.88L13.88,8.32z M19.75,59.66l4.23-1.21v15.81l-4.23-1.53V59.66L19.75,59.66z"/>
                    <text x="48" y="75" text-anchor="middle" fill="black" font-size="50" font-weight="bold">A</text>
                </svg>
            </div>

            <!-- Door B — timer sits above this one -->
            <div class="door-col">
                <div class="countdown" id="timer">30</div>
                <svg width="150" height="150" viewBox="-13.22 0 122.88 122.88" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#2DC84D" fill-rule="evenodd" clip-rule="evenodd" d="M0,115.27h4.39V1.99V0h1.99h82.93h1.99v1.99v113.28h5.14v7.61H0V115.27L0,115.27z M13.88,8.32H81.8h0.83v0.83 v104.89h4.69V3.97H8.36v111.3h4.69V9.15V8.32H13.88L13.88,8.32z M19.75,59.66l4.23-1.21v15.81l-4.23-1.53V59.66L19.75,59.66z"/>
                    <text x="48" y="75" text-anchor="middle" fill="black" font-size="50" font-weight="bold">B</text>
                </svg>
            </div>

            <!-- Door C -->
            <div class="door-col">
                <div class="spacer"></div>
                <svg width="150" height="150" viewBox="-13.22 0 122.88 122.88" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#2DC84D" fill-rule="evenodd" clip-rule="evenodd" d="M0,115.27h4.39V1.99V0h1.99h82.93h1.99v1.99v113.28h5.14v7.61H0V115.27L0,115.27z M13.88,8.32H81.8h0.83v0.83 v104.89h4.69V3.97H8.36v111.3h4.69V9.15V8.32H13.88L13.88,8.32z M19.75,59.66l4.23-1.21v15.81l-4.23-1.53V59.66L19.75,59.66z"/>
                    <text x="48" y="75" text-anchor="middle" fill="black" font-size="50" font-weight="bold">C</text>
                </svg>
            </div>

        </div>
    </div>

    <script>
        let timeLeft = 30;

        function startTimer() {
            const timerDisplay = document.getElementById("timer");
            const countdown = setInterval(() => {
                timeLeft--;
                timerDisplay.textContent = timeLeft;

                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    fetch("/rooms-end/{{ gameId }}", { method: "POST" })
                        .then(() => window.location.href = "/rooms-end-host/{{ gameId }}");
                }
            }, 1000);
        }
    </script>

</body>
</html>
