<!DOCTYPE html>
<html lang="en">
<head>

    <title>Lobby</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
        }

        .navbar {
            background-color: #2dc84d;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .title-box {
            border: 2px solid #2dc84d;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            margin-bottom: 40px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
            color: #2dc84d;
        }

        .main-container {
            display: flex;
            justify-content: space-between;
            gap: 30px;
        }

        .players-section {
            flex-grow: 1;
        }

        .player-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .player-name {
            color: #2dc84d;
            font-weight: bold;
            font-size: 36px;
        }

        .controls {
            display: flex;
            flex-direction: column;
            gap: 15px;
            min-width: 180px;
        }

        .btn {
            padding: 14px 22px;
            font-size: 16px;
            background-color: black;
            color: #2dc84d;
            border: 2px solid #2dc84d;
            cursor: pointer;
            border-radius: 6px;
            text-align: center;
        }

        .btn:hover {
            background-color: #2dc84d;
            color: black;
        }

        .btn-start {
            background-color: #2dc84d;
            color: black;
        }

        .btn-start:hover {
            background-color: #23A03D;
        }

        .content {
            margin: 40px;
        }

        .warning-bar {
        position: fixed;
        bottom: 0;
        width: 100%;
        background-color: black;
        border-top: 2px solid #2dc84d;
        color: #2dc84d;
        display: none;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        }
    </style>

    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
        }

        .title-box {
            border: 2px solid #d33469;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            margin-bottom: 40px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
            color: black;
        }

        .main-container {
            display: flex;
            justify-content: space-between;
            gap: 30px;
        }

        .players-section {
            flex-grow: 1;
        }

        .player-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .player-name {
            color: #d33469;
            font-weight: bold;
            font-size: 32px;
        }

        .controls {
            display: flex;
            flex-direction: column;
            gap: 15px;
            min-width: 180px;
        }

        .btn {
            padding: 14px 22px;
            font-size: 16px;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            cursor: pointer;
            border-radius: 6px;
            text-align: center;
        }

        .btn:hover {
            background-color: #b02a57;
            color: white;
        }

        .btn-start {
            background-color: #d33469;
            color: white;
        }

        .btn-start:hover {
            background-color: #b02a57;
        }

        .content {
            margin: 40px;
        }

        .warning-bar {
        position: fixed;
        bottom: 0;
        width: 100%;
        background-color: white;
        border-top: 2px solid #d33469;
        color: black;
        display: none;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        }
    </style>
    {% endif %}
</head>

<body>

<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="title-box">
        <h1>Room Code: {{ roomCode }}</h1>
    </div>

    <div class="main-container">

        <div class="players-section">
            <div class="player-grid" id="player-grid">
                {% for player in players %}
                    <div class="player-name">{{ player }}</div>
                {% endfor %}
            </div>
        </div>

        <div class="controls">
            <form id="start-form" method="post" action="/start-game/{{ gameId }}">
                <button type="submit" class="btn btn-start">Start Quiz</button>
            </form>

            <form method="get" action="/settings/{{ gameId }}">
                <input type="hidden" name="return" value="/lobby-server/{{ gameId }}">
                <button type="submit" class="btn">Settings</button>
            </form>

            <form method="post" action="/close-lobby/{{ gameId }}">
                <button type="submit" class="btn">Close Lobby</button>
            </form>
        </div>

    </div>

</div>

<div class="warning-bar" id="warning-bar">
    <span>Minigames won't activate without a minimum of 2 players</span>
    <div>
        <button class="btn" onclick="hideWarning()">Wait</button>
        <button class="btn btn-start" onclick="forceStart()">Ignore</button>
    </div>
</div>

<script>
    let currentPlayerCount = 0;
    const pollPlayers = setInterval(() => {
        fetch("/lobby-players/{{ gameId }}")
            .then(response => response.json())
            .then(players => {
                currentPlayerCount = players.length;
                const fontSize = players.length > 25 ? "12px" : players.length > 15 ? "18px" : "32px";
                const grid = document.getElementById("player-grid");
                grid.innerHTML = players
                    .map(p => `<div class="player-name" style="font-size:${fontSize}">${p}</div>`)
                    .join("");
            })
            .catch(err => console.log("Player poll error: " + err));
    }, 1000);

    window.onload = function () {
        document.getElementById("start-form").addEventListener("submit", function(e) {
            if (currentPlayerCount <= 1 && {{ miniGamesEnabled }}) {
                e.preventDefault();
                document.getElementById("warning-bar").style.display = "flex";
            }
        });
    };

    function hideWarning() {
        document.getElementById("warning-bar").style.display = "none";
    }

    function forceStart() {
        document.getElementById("start-form").submit();
    }
</script>

</body>
</html>