<!DOCTYPE html>
<html lang="en">
<head>
    <title>Game Night</title>
    <script>
        <!--- ALL OF THIS IS JUST TO TEST HOW WEBSOCKETS WORK :) --->
        let serverURL;
        let socket;

        function setupSocket() {
            serverURL = 'ws://127.0.0.1:8080/gameServer';
            socket = new WebSocket(serverURL);

            socket.onopen = logOpenToConsole;
            socket.onclose = logCloseToConsole;
            socket.onmessage = test;
        }

        function logOpenToConsole() {
            console.log("Web socket connection opened");
        }

        function logCloseToConsole() {
            console.log("Web socket connection closed");
        }

        function test(event) {
            let questionData = JSON.parse(event.data);
            console.log(`Retrieved question: ${questionData.questionText}`);
            console.log(`Retrieved answers: ${questionData.answerOne}, ${questionData.answerTwo}, ${questionData.answerThree}, ${questionData.answerFour} `);

            let data = buildAnswer()
            sendAnswerViaSocket(data)

        }

        <!--- temp userID, will need to pass this into peb file --->
        function buildAnswer() {
            return {
                userID: 1,
                chosenAnswer: 0,
                answerSpeed: 1.0
            }
        }

        function sendAnswerViaSocket(data) {
            socket.send(JSON.stringify(data));
        }
    </script>
    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
        }

        /* ── Navbar ── */
        .navbar {
            background-color: #cfe2f3;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-box {
            border: 2px solid #1a5276;
            padding: 6px 14px;
            font-weight: bold;
            color: #1a5276;
            font-size: 14px;
            /* Replace the text below with an <img> tag once a logo is available */
        }

        .site-name {
            color: #1a5276;
            font-weight: bold;
            font-size: 16px;
        }

        .navbar-right {
            display: flex;
            gap: 10px;
        }

        .btn-signup {
            background-color: #1a5276;
            color: white;
            border: none;
            padding: 8px 22px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-signup:hover {
            background-color: #154360;
        }

        .btn-login {
            background-color: white;
            color: #1a5276;
            border: 2px solid #aaa;
            padding: 8px 22px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-login:hover {
            background-color: #f0f0f0;
        }

        /* ── Main content ── */
        .main {
            padding: 30px 40px;
        }

        h1 {
            text-align: center;
            font-weight: bold;
            font-size: 2em;
            color: black;
            margin-bottom: 30px;
        }

        /* ── Content sections ── */
        .section-title {
            font-weight: bold;
            font-size: 1.1em;
            color: black;
            margin-bottom: 8px;
        }

        .content-box {
            border: 1px solid #1a5276;
            background-color: white;
            min-height: 160px;
            width: 100%;
            padding: 16px;
            font-size: 14px;
            color: #333;
            /* Add your description text between these tags when ready */
        }

        /* Left-aligned block (What is this?) */
        .block-left {
            width: 58%;
            margin-bottom: 30px;
        }

        /* Right-aligned block (What do we offer?) */
        .block-right {
            width: 58%;
            margin-left: auto;
            text-align: right;
        }

        .block-right .content-box {
            text-align: left;
        }

    </style>
</head>

<body>
    <!-- Navigation bar -->
    <nav class="navbar">
        <div class="navbar-left">
            <div class="logo-box">Logo</div>
            <span class="site-name">Game Night</span>
        </div>
        <div class="navbar-right">
            <button class="btn-signup" onclick="window.location.href='/signup'">Sign Up</button>
            <button class="btn-login" action="javascript:test()" onclick="window.location.href='/login'">Log In</button>
        </div>
    </nav>

    <!-- Page content -->
    <main class="main">

        <h1>Welcome to Game Night!</h1>

        <!-- What is this? -->
        <div class="block-left">
            <h2 class="section-title">What is this?</h2>
            <div class="content-box">
                <!-- TODO: Add a short description of the website here -->
            </div>
        </div>

        <!-- What do we offer? -->
        <div class="block-right">
            <h2 class="section-title">What do we offer?</h2>
            <div class="content-box">
                <!-- TODO: Add a description of your features/offerings here -->
            </div>
        </div>

    </main>

</body>
</html>
