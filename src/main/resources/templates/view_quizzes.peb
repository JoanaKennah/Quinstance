<!DOCTYPE html>
<html lang="en">
<head>
    <title>View Quizzes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }
        
        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title {
            font-size: 28px;
            color: black;
            margin-bottom: 20px;
        }

        .filters {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .filters label {
            color: #d33469;
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
            text-align: left;
        }

        .filters select {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        .quiz-container {
            max-height: 400px;
            overflow-y: auto;
            margin-bottom: 40px;
        }

        .quiz-box {
            border: 2px solid #d33469;
            background-color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            text-align: left;
        }

        .empty {
            color: #d33469;
            font-size: 20px;
            margin-top: 100px;
        }

        .bottom-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn {
            padding: 10px 20px;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            cursor: pointer;
            border-radius: 5px;
        }

        .btn:hover {
            background-color: #d33469;
            color: white;
        }
    </style>
</head>

<body>
  
<div class="navbar">
    <a>View Quizzes</a>
</div>

<div class="content">

    <div class="title">
        {{ username }}'s Quizzes
    </div>

    <div class="filters">
        <div>
            <label for="categoryFilter">Category:</label>
            <select id="categoryFilter" name="category" onchange="filterQuizzes()">
                <option value="">All</option>
                <option value="art">Art and Design</option>
                <option value="biology">Biology</option>
                <option value="business">Business Studies</option>
                <option value="chemistry">Chemistry</option>
                <option value="cs">Computer Science</option>
                <option value="dt">Design and Technology</option>
                <option value="drama">Drama</option>
                <option value="eng_lang">English Language</option>
                <option value="eng_lit">English Literature</option>
                <option value="french">French</option>
                <option value="geography">Geography</option>
                <option value="german">German</option>
                <option value="history">History</option>
                <option value="latin">Latin</option>
                <option value="maths">Mathematics</option>
                <option value="media">Media Studies</option>
                <option value="music">Music</option>
                <option value="pe">Physical Education</option>
                <option value="physics">Physics</option>
                <option value="rs">Religious Studies</option>
                <option value="spanish">Spanish</option>
                <option value="other">Other</option>
            </select>
        </div>

        <div>
            <label for="keyStageFilter">Key Stage:</label>
            <select id="keyStageFilter" name="keystage" onchange="filterQuizzes()">
                <option value="">All</option>
                <option value="KS1">Key Stage 1</option>
                <option value="KS2">Key Stage 2</option>
                <option value="KS3">Key Stage 3</option>
                <option value="KS4">Key Stage 4</option>
                <option value="KS5">Key Stage 5</option>
                <option value="furthereducation">Further Education</option>
                <option value="nonapplicable">N/A</option>
            </select>
        </div>
    </div>

    {% if quizzes is empty %}
        <div class="empty">
            No quizzes found!
        </div>
    {% else %}
        <div class="quiz-container" id="quiz-container">
            {% for quiz in quizzes %}
                <div class="quiz-box"
                     data-category="{{ quiz.category }}"
                     data-keystage="{{ quiz.keyStage }}"
                     style="display: flex; justify-content: space-between; align-items: center;">
                    <a href="/view-quiz/{{ quiz.id }}" style="flex-grow: 1; text-decoration: none; color: black;">
                        {{ loop.index + 1 }}. {{ quiz.quizName }}
                    </a>

                    <form action="/delete-quiz/{{ quiz.id }}" method="post" style="margin: 0;">
                        <button
                            type="submit"
                            class="btn"
                            onclick="return confirm('Are you sure you want to delete this quiz?');">
                            Delete
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>

        <div class="empty" id="no-results" style="display: none;">
            No quizzes match the selected filters.
        </div>

    {% endif %}

    <div class="bottom-bar">
        <button class="btn" onclick="window.location.href='/create-quiz'">+ Create a Quiz</button>
        <button class="btn" onclick="window.location.href='{{ returnURL }}'">Return</button>
    </div>

</div>

<script>
    function filterQuizzes() {
        const selectedCategory = document.getElementById("categoryFilter").value;
        const selectedKeyStage = document.getElementById("keyStageFilter").value;
        const boxes = document.querySelectorAll(".quiz-box");
        let visibleCount = 0;

        boxes.forEach(box => {
            const category = box.getAttribute("data-category");
            const keyStage = box.getAttribute("data-keystage");

            const categoryMatch = selectedCategory === "" || category === selectedCategory;
            const keyStageMatch = selectedKeyStage === "" || keyStage === selectedKeyStage;

            if (categoryMatch && keyStageMatch) {
                box.style.display = "flex";
                visibleCount++;
            } else {
                box.style.display = "none";
            }
        });

        const noResults = document.getElementById("no-results");
        if (noResults) {
            noResults.style.display = visibleCount === 0 ? "block" : "none";
        }
    }
</script>

</body>
</html>