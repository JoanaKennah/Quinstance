<!DOCTYPE html>
<html lang="en">
<head>
    <title>Rooms</title>
    <!-- graphics from svgrepo -->
    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2DC84D;
        }

        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 25px;
        }

        .title-box {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: black;
            color: #2DC84D;
            border: 2px solid #2DC84D;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #2DC84D;
            color: black;
        }

        .description {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .arena {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
        }

        .username-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            min-width: 120px;
        }

        .username {
            font-size: 16px;
            font-weight: bold;
            color: white;
        }

        .door-container {
            position: relative;
            width: 150px;
            height: 150px;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 25px;
        }

        .title-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #e63973;
            color: white;
        }

        .description {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .arena {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
        }

        .username-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            min-width: 120px;
        }

        .username {
            font-size: 16px;
            font-weight: bold;
        }

        .door-container {
            position: relative;
            width: 150px;
            height: 150px;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">

        <div class="top-row">
            <div></div>
            <div class="title-box">
                <h1>Rooms</h1>
            </div>
            <form method="post" action="/next-question/{{ gameId }}">
                <button type="submit" class="btn-next">Next</button>
            </form>
        </div>

        <div class="description">
            Uh oh! Room {{ ghostRoom }} contained a ghost - you all got so scared you became a ghost too!
        </div>

        <div class="arena">

            <!-- Left columns -->
            <div class="username-col">
                {% for user in left_col1 %}
                    <div class="username">{{ user }}</div>
                {% endfor %}
            </div>

            <div class="username-col">
                {% for user in left_col2 %}
                    <div class="username">{{ user }}</div>
                {% endfor %}
            </div>

            <!-- Open door w/ ghost overlay -->
            <div class="door-container">
                <!-- graphics from svgrepo -->
                <svg width="150" height="150" viewBox="-13.22 0 122.88 122.88" xmlns="http://www.w3.org/2000/svg">
                    {% if theme == "spooky" %}
                        <path fill="#2DC84D" fill-rule="evenodd" clip-rule="evenodd" d="M0,115.27h4.39V1.99V0h1.99h82.93h1.99v1.99v113.28h5.14v7.61H0V115.27L0,115.27z M13.88,8.32H81.8h0.83v0.83 v104.89h4.69V3.97H8.36v111.3h4.69V9.15V8.32H13.88L13.88,8.32z M15.94,114.04H75.1l-0.38-0.15l-27.76-3.79V33.9l32.79-20.66v-2.04 H15.94V114.04L15.94,114.04z M51.7,59.66l4.23-1.21v15.81l-4.23-1.53V59.66L51.7,59.66z"/>
                    {% else %}
                        <path fill="#e63973" fill-rule="evenodd" clip-rule="evenodd" d="M0,115.27h4.39V1.99V0h1.99h82.93h1.99v1.99v113.28h5.14v7.61H0V115.27L0,115.27z M13.88,8.32H81.8h0.83v0.83 v104.89h4.69V3.97H8.36v111.3h4.69V9.15V8.32H13.88L13.88,8.32z M15.94,114.04H75.1l-0.38-0.15l-27.76-3.79V33.9l32.79-20.66v-2.04 H15.94V114.04L15.94,114.04z M51.7,59.66l4.23-1.21v15.81l-4.23-1.53V59.66L51.7,59.66z"/>
                    {% endif %}
                </svg>
                <!-- ghost overlay -->
                <svg style="position: absolute; top: -10px; left: -15px; pointer-events: none;"
                    width="130" height="130" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    {% if theme == "spooky" %}
                        <path fill="white" d="M417.913,490.426c-0.385-0.138-38.763-14.23-55.472-58.08c-14.151-37.133-6.785-79.476,19.224-110.507c14.821-17.682,63.176-79.533,63.176-132.999C444.84,84.714,360.127,0,256.001,0S67.161,84.714,67.161,188.84c0,69.232,32.57,145.853,87.125,204.963c45.579,49.385,127.55,109.975,259.215,118.176c0.234,0.014,0.467,0.022,0.699,0.022c5.239,0,9.811-3.685,10.875-8.88C426.183,497.695,423.129,492.281,417.913,490.426z M170.611,378.734c-50.867-55.113-81.234-126.102-81.234-189.895c0-91.876,74.747-166.623,166.623-166.623s166.623,74.747,166.623,166.623c0,36.528-29.954,85.282-57.986,118.728c-31.175,37.196-39.972,88.039-22.957,132.689c7.327,19.227,18.055,33.74,28.872,44.473C271.864,468.026,208.092,419.344,170.611,378.734z M234.291,141.511c0-23.67-14.638-42.211-33.325-42.211c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.637,42.211,33.325,42.211C219.652,183.722,234.291,165.181,234.291,141.511z M200.966,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C212.074,152.955,206.21,161.506,200.966,161.506z M305.382,99.3c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.638,42.211,33.325,42.211s33.325-18.541,33.325-42.211C338.707,117.84,324.07,99.3,305.382,99.3z M305.382,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C316.49,152.955,310.626,161.506,305.382,161.506z M253.174,201.495c-22.356,0-40.545,18.189-40.545,40.545v32.214c0,22.356,18.189,40.545,40.545,40.545c22.355,0,40.545-18.189,40.545-40.545V242.04C293.719,219.684,275.53,201.495,253.174,201.495z M271.502,274.254c0,10.106-8.221,18.329-18.329,18.329c-10.106,0-18.329-8.222-18.329-18.329V242.04c0-10.106,8.222-18.329,18.329-18.329c10.106,0,18.329,8.222,18.329,18.329V274.254z M361.099,257.152c1.806,1.102,3.802,1.626,5.773,1.626c3.746,0,7.401-1.895,9.494-5.326c15.503-25.419,24.04-48.366,24.04-64.613c0-6.135-4.974-11.108-11.108-11.108c-6.134,0-11.108,4.973-11.108,11.108c0,11.869-7.772,31.698-20.791,53.045C354.205,247.121,355.862,253.957,361.099,257.152z"/>
                    {% else %}
                        <path fill="#e63973" d="M417.913,490.426c-0.385-0.138-38.763-14.23-55.472-58.08c-14.151-37.133-6.785-79.476,19.224-110.507c14.821-17.682,63.176-79.533,63.176-132.999C444.84,84.714,360.127,0,256.001,0S67.161,84.714,67.161,188.84c0,69.232,32.57,145.853,87.125,204.963c45.579,49.385,127.55,109.975,259.215,118.176c0.234,0.014,0.467,0.022,0.699,0.022c5.239,0,9.811-3.685,10.875-8.88C426.183,497.695,423.129,492.281,417.913,490.426z M170.611,378.734c-50.867-55.113-81.234-126.102-81.234-189.895c0-91.876,74.747-166.623,166.623-166.623s166.623,74.747,166.623,166.623c0,36.528-29.954,85.282-57.986,118.728c-31.175,37.196-39.972,88.039-22.957,132.689c7.327,19.227,18.055,33.74,28.872,44.473C271.864,468.026,208.092,419.344,170.611,378.734z M234.291,141.511c0-23.67-14.638-42.211-33.325-42.211c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.637,42.211,33.325,42.211C219.652,183.722,234.291,165.181,234.291,141.511z M200.966,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C212.074,152.955,206.21,161.506,200.966,161.506z M305.382,99.3c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.638,42.211,33.325,42.211s33.325-18.541,33.325-42.211C338.707,117.84,324.07,99.3,305.382,99.3z M305.382,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C316.49,152.955,310.626,161.506,305.382,161.506z M253.174,201.495c-22.356,0-40.545,18.189-40.545,40.545v32.214c0,22.356,18.189,40.545,40.545,40.545c22.355,0,40.545-18.189,40.545-40.545V242.04C293.719,219.684,275.53,201.495,253.174,201.495z M271.502,274.254c0,10.106-8.221,18.329-18.329,18.329c-10.106,0-18.329-8.222-18.329-18.329V242.04c0-10.106,8.222-18.329,18.329-18.329c10.106,0,18.329,8.222,18.329,18.329V274.254z M361.099,257.152c1.806,1.102,3.802,1.626,5.773,1.626c3.746,0,7.401-1.895,9.494-5.326c15.503-25.419,24.04-48.366,24.04-64.613c0-6.135-4.974-11.108-11.108-11.108c-6.134,0-11.108,4.973-11.108,11.108c0,11.869-7.772,31.698-20.791,53.045C354.205,247.121,355.862,253.957,361.099,257.152z"/>
                    {% endif %}
                </svg>
            </div>

            <!-- Right columns -->
            <div class="username-col">
                {% for user in right_col1 %}
                    <div class="username">{{ user }}</div>
                {% endfor %}
            </div>

            <div class="username-col">
                {% for user in right_col2 %}
                    <div class="username">{{ user }}</div>
                {% endfor %}
            </div>

        </div>
    </div>
</body>
</html>
