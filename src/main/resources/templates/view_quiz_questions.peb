<!DOCTYPE html>
<html lang="en">
<head>
    <title>Quiz Questions</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
        }

        .title-box {
            border: 2px solid #e63973;
            background-color: white;
            padding: 20px;
            text-align: center;
            border-radius: 10px;
        }

        .title-box h1 {
            color: black;
            margin: 0;
        }

        .csv-container {
            display: flex;
            margin: 20px;
            justify-content: flex-end;
        }

        .csv-text {
              color: #e63973;
              margin: 10px;
              font-size: 20px;
        }

        .csv-button {
              color: #e63973;
              margin: 5px;
              font-size: 20px;
        }

        .button-bar {
            margin-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .add-btn {
            background-color: #e63973;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }
      
        .add-btn:hover {
            background-color: #d6285f;
        }

        .next-btn {
            padding: 10px 20px;
            background-color: #e63973;
            color: white;
            border: none;
            cursor: pointer;
        }

        .next-btn:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }
      
        .next-btn:hover {
            background-color: #d6285f;
        }

        .questions-container {
            margin-top: 30px;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .question-box {
            border: 2px solid #e63973;
            background-color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            color: black;
        }

        .bottom-bar {
            margin-top: 40px;
        }

        .btn {
            padding: 10px 20px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            cursor: pointer;
            border-radius: 5px;
        }

        .btn:hover {
            background-color: #e63973;
            color: white;
        }
    </style>

    <script>
        function validateForm() {
            const questionCount = {{ questions | length }};
            
            if (questionCount === 0) {
                alert("You must add at least one question before continuing.");
                return false;
            }
            return true;
        }

        function deleteQuestion() {
            var choice;
            if (confirm("This quiz already has questions. If you import a file, these will be deleted. Is that ok?")) {
                choice = true;
            } else {
                choice = false;
            }
            document.getElementById("csvChoice").value = choice;
        }
    </script>
</head>

<body>

<div class="navbar">
  <a>Quiz Creation</a>
</div>

<div class="content">

    <div class="title-box">
        <h1>{{ quizName }}</h1>
    </div>

    <div class="button-bar">

        <a class="add-btn" href="/add-question/{{ quizId }}">
            + Add a Question
        </a>

        <div class="csv-container">
            <b class="csv-text">Already have some questions? Submit a .csv file:</b>

            <form method="post"
                  action="/view-quiz-questions/{{ quizId }}"
                  enctype="multipart/form-data"
                  onsubmit=csvChoice>
                <input type="file" class="csv-button" name="filename">
                <input type="hidden" name="quizId" value={{ quizId }}>
                <input type="hidden" name="resetQuestions" id="csvChoice">
                <input {% if questions is not empty %}onclick="deleteQuestion()"{% endif %} type="submit">
            </form>
        </div>

        <form method="post" action="/quiz-created/{{ quizId }}" onsubmit="return validateForm()">
            <button class="next-btn" type="submit"
                {% if questions is empty %}disabled{% endif %}>
                Next
            </button>
        </form>

    </div>

    <div class="questions-container">

        {% for question in questions %}
            <div class="question-box" onclick="window.location.href='/add-question/{{ quiz.id }}'">
                {{ loop.index + 1 }}. {{ question.question }}
            </div>
        {% endfor %}

    </div>
    <div class="bottom-bar">
        <button class="btn" onclick="window.location.href='{{ returnURL }}'">Return</button>
    </div>
</div>



</body>
</html>