<!DOCTYPE html>
<html lang="en">
<head>
    <title>Words</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2DC84D;
        }

        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 25px;
        }

        .title-box {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: black;
            color: #2DC84D;
            border: 2px solid #2DC84D;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #2DC84D;
            color: black;
        }

        .description {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .words-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            max-width: 800px;
            margin: 0 auto;
        }

        .word-item {
            border: 2px solid #2DC84D;
            border-radius: 8px;
            padding: 12px;
        }

        .word-item .username {
            font-size: 13px;
            opacity: 0.7;
            margin-bottom: 4px;
        }

        .word-item .word {
            font-size: 20px;
            font-weight: bold;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            color: white;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 25px;
        }

        .title-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #e63973;
            color: white;
        }

        .description {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .words-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            max-width: 800px;
            margin: 0 auto;
        }

        .word-item {
            border: 2px solid #e63973;
            border-radius: 8px;
            padding: 12px;
        }

        .word-item .username {
            font-size: 13px;
            opacity: 0.7;
            margin-bottom: 4px;
        }

        .word-item .word {
            font-size: 20px;
            font-weight: bold;
        }
    </style>
    {% endif %}
</head>
<body>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">
        <div class="top-row">
            <div></div>
            <div class="title-box"><h1>Words</h1></div>
            <form method="post" action="/words-reveal/{{ gameId }}">
                <button type="submit" class="btn-next">Next</button>
            </form>
        </div>

        <div class="description">Here are the words you all created:</div>

        <div class="words-grid">
            {% for entry in playerWords %}
                <div class="word-item">
                    <div class="username">{{ entry.username }}</div>
                    <div class="word">{{ entry.word }}</div>
                </div>
            {% endfor %}
        </div>
    </div>
</body>
</html>