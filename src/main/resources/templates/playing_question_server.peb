    <!DOCTYPE html>
    <html lang="en">
    <head>
        <title>Play Quiz on Server</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        {% if theme == "spooky" %}
        <style>
            body {
                font-family: Arial, sans-serif;
                margin: 0;
                background-color: black;
            }
            .navbar {
                background-color: #2DC84D;
                display: flex;
                justify-content: flex-end;
                padding: 12px 20px;
            }
            .navbar a {
                color: black;
                text-decoration: none;
                font-weight: bold;
            }
            .content {
                margin: 40px;
                text-align: center;
            }
            .question-title {
                color: #2DC84D;
                font-size: 28px;
                margin-bottom: 20px;
            }
            .question-box {
                border: 4px solid #2DC84D;
                background-color: black;
                color: #2DC84D;
                padding: 20px;
                border-radius: 10px;
                width: 100%;
                box-sizing: border-box;
                font-size: 20px;
            }
            .timer {
                margin-top: 30px;
                font-size: 26px;
                color: #2DC84D;
            }
            .btn {
                padding: 10px 20px;
                background-color: black;
                color: #2DC84D;
                border: 2px solid #2DC84D;
                cursor: pointer;
                border-radius: 5px;
            }

            .btn:hover {
                background-color: #2DC84D;
                color: black;
            }
            .button-container {
                display: flex;
                justify-content: flex-end;
                margin-top: 20px;
            }
        </style>
        {% else %}
        <style>
            body {
                font-family: Arial, sans-serif;
                margin: 0;
            }
        
            .navbar {
                background-color: #e63973;
                display: flex;
                justify-content: flex-end;
                padding: 12px 20px;
            }
        
            .navbar a {
                color: white;
                text-decoration: none;
                font-weight: bold;
            }

            .content {
                margin: 40px;
                text-align: center;
            }

            .question-title {
                color: black;
                font-size: 28px;
                margin-bottom: 20px;
            }

            .question-box {
                border: 4px solid #e63973;
                background-color: white;
                color: black;
                padding: 20px;
                border-radius: 10px;
                width: 100%;
                box-sizing: border-box;
                font-size: 20px;
            }

            .timer {
                margin-top: 30px;
                font-size: 26px;
                color: black;
            }

            .btn {
                padding: 10px 20px;
                background-color: white;
                color: black;
                border: 2px solid #e63973;
                cursor: pointer;
                border-radius: 5px;
            }

            .btn:hover {
                background-color: #e63973;
                color: white;
            }

            .button-container {
                display: flex;
                justify-content: flex-end;
                margin-top: 20px;
            }
        </style>
        {% endif %}

        <script>

            function startTimer() {
                 
                const timerDisplay = document.getElementById("timer");
                if ({{ timeLimit }} == 0) {
                    timerDisplay.textContent = "Unlimited Time";
                    return;
                } else {
                    const endTime = Date.now() + {{ timeLimit }}000;
                    localStorage.setItem("quizEndTime", endTime);
                    const countdown = setInterval(() => {
                        const endTime = localStorage.getItem("quizEndTime");
                        const timeLeft = Math.floor((endTime - Date.now()) / 1000);
                        timerDisplay.textContent = timeLeft;

                        if (timeLeft <= 0) {
                            clearInterval(countdown);
                            localStorage.removeItem("quizEndTime");
                            fetch("/show-correct-answer/{{ gameId }}", { method: "POST" })
                                .then(() => window.location.href = "/show-correct-answer/{{ gameId }}");
                        }
                    }, 1000);
                }
            }

            function goToNext() {
                fetch("/show-correct-answer/{{ gameId }}", { method: "POST" })
                    .then(response => response.text())
                    .then(html => {
                        document.open();
                        document.write(html);
                        document.close();
                    });
            }

            window.onload = startTimer;

        </script>

    </head>

    <body>

    <div class="navbar">
    <a>{{ quizName }}</a>
    </div>

    <div class="content"> <!--- NEED TO ADD BACKEND CODE TO CYCLE THROUGH QUESTIONS --->

        <div class="question-title">
            Question {{ questionNumber }}:
        </div>

        <div class="question-box">
            {{ questionText }}
        </div>

        <div class="timer">
            <span id="timer">
                {% if timeLimit == 0 %}
                    Unlimited Time
                {% else %}
                    {{ timeLimit }}
                {% endif %}
            </span>
        </div>

        <div class="button-container">
            <button class="btn" onclick="goToNext()">
                Next
            </button>
        </div>

    </div>

    </body>
    </html>