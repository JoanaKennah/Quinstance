<!DOCTYPE html>
<html lang="en">
<head>
    <title>Error</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f5f5f5;
        }

        .title {
            color: red;
            font-size: 48px;
            font-weight: bold;
            text-align: center;
        }

        .message {
            color: black;
            font-size: 16px;
            margin-top: 10px;
            text-align: center;
            max-width: 400px;
        }

        .back-button {
            margin-top: 20px;
            padding: 10px 18px;
            font-size: 14px;
            border: none;
            background-color: #333;
            color: white;
            cursor: pointer;
            border-radius: 6px;
        }

        .back-button:hover {
            background-color: #555;
        }
    </style>
</head>
<body>

    <div class="title">Error</div>
    <div class="message">
        {{errorMessage}}
    </div>

    <button class="back-button" onclick="goBack()">Return</button>

    <script>
        function goBack() {
            window.history.back();
        }
    </script>

</body>
</html>