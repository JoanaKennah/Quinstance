<!DOCTYPE html>
<html lang="en">
<head>
    <title>Lobby</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 20px;
            margin: 0 auto 40px auto;
            display: inline-block;
            width: 80%;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
            color: black;
        }

        .waiting-message {
            color: #e63973;
            font-weight: bold;
            font-size: 20px;
            margin-bottom: 35px;
        }

        .room-code-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 18px 40px;
            display: inline-block;
            margin-bottom: 30px;
        }

        .room-code-box span {
            color: #e63973;
            font-weight: bold;
            font-size: 24px;
        }

        .leave-btn {
            display: block;
            width: 200px;
            margin: 0 auto;
            padding: 14px;
            font-size: 18px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
        }

        .leave-btn:hover {
            background-color: #e63973;
            color: white;
        }
    </style>

    <script>
        const socket = new WebSocket("ws://" + location.host + "/game/{{ gameId }}");
        
        socket.onmessage = function(event) {
            const data = JSON.parse(event.data);
            if (data.redirect) {
                window.location.href = data.redirect;
            }
        }

        socket.onerror = function(error) {
            console.log("WebSocket error: " + error);
        }
    </script>

</head>

<body>

<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="title-box">
        <h1>{{ quizName }} Lobby</h1>
    </div>

    <div class="waiting-message">
        You are now in the quiz lobby, see your name on the big screen!
    </div>

    <div class="room-code-box">
        <span>Room Code: {{ roomCode }}</span>
    </div>

    <br>

    <form method="post" action="/leave-lobby/{{ gameId }}">
        <button type="submit" class="leave-btn">Leave Lobby</button>
    </form>

</div>

</body>
</html>