<!DOCTYPE html>
<html lang="en">
<head>
    <title>Lobby</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
        font-family: Arial, sans-serif;
        margin: 0;
        background-color: black;
        }
        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }
        .content {
            margin: 40px;
            text-align: center;
        }
        .title-box {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 20px;
            margin: 0 auto 40px auto;
            display: inline-block;
            width: 80%;
        }
        .title-box h1 {
            margin: 0;
            font-size: 32px;
            color: #2DC84D;
        }
        .waiting-message {
            color: #2DC84D;
            font-weight: bold;
            font-size: 20px;
            margin-bottom: 35px;
        }
        .room-code-box {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 18px 40px;
            display: inline-block;
            margin-bottom: 30px;
        }
        .room-code-box span {
            color: #2DC84D;
            font-weight: bold;
            font-size: 24px;
        }
        .leave-btn {
            display: block;
            width: 200px;
            margin: 0 auto;
            padding: 14px;
            font-size: 18px;
            background-color: black;
            color: #2DC84D;
            border: 2px solid #2DC84D;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
        }
        .leave-btn:hover {
            background-color: #2DC84D;
            color: black;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title-box {
            border: 2px solid #d33469;
            border-radius: 10px;
            padding: 20px;
            margin: 0 auto 40px auto;
            display: inline-block;
            width: 80%;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
            color: black;
        }

        .waiting-message {
            color: #d33469;
            font-weight: bold;
            font-size: 20px;
            margin-bottom: 35px;
        }

        .room-code-box {
            border: 2px solid #d33469;
            border-radius: 10px;
            padding: 18px 40px;
            display: inline-block;
            margin-bottom: 30px;
        }

        .room-code-box span {
            color: #d33469;
            font-weight: bold;
            font-size: 24px;
        }

        .leave-btn {
            display: block;
            width: 200px;
            margin: 0 auto;
            padding: 14px;
            font-size: 18px;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
        }

        .leave-btn:hover {
            background-color: #b02a57;
            color: white;
        }
    </style>
    {% endif %}
    

    <script>
    // Poll every 500ms to check if host has started the game
    const checkGameStarted = setInterval(() => {
        fetch("/game-started/{{ gameId }}")
            .then(response => response.json())
            .then(data => {
                if (data.started) {
                    clearInterval(checkGameStarted);
                    window.location.href = "/game/{{ gameId }}";
                }
            })
            .catch(err => console.log("Polling error: " + err));
        }, 500);

    //polls to check if player kicked
        const kickPoll = setInterval(() => {
            fetch("/is-kicked/{{ gameId }}")
                .then(response => response.json())
                .then(data => {
                    if (data.kicked) {
                        clearInterval(kickPoll);
                        window.location.href = "/kicked/{{ gameId }}";
                    }
                })
                .catch(err => console.log("Kick poll error: " + err));
        }, 1000);
    </script>

</head>

<body>

<div class="navbar">
    <a href="/quit-game" style="color: black; text-decoration: none; font-weight: bold;">Quit</a>
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="title-box">
        <h1>{{ quizName }} Lobby</h1>
    </div>

    <div class="waiting-message">
        You are now in the quiz lobby, see your name on the big screen!
    </div>

    <div class="room-code-box">
        <span>Room Code: {{ roomCode }}</span>
    </div>

    <br>

    <form method="post" action="/leave-lobby/{{ gameId }}">
        <button type="submit" class="leave-btn">Leave Lobby</button>
    </form>

</div>

</body>
</html>