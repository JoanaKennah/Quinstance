<!DOCTYPE html>
<html lang="en">
<head>
    <title>Correct Answer</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }
        
        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .question-title {
            color: black;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .question-box {
            border: 4px solid #e63973;
            background-color: white;
            color: black;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            font-size: 20px;
        }

        .answer-label {
            margin-top: 30px;
            font-size: 22px;
            color: black;
        }

        .answer-box {
            margin-top: 15px;
            border: 4px solid #e63973;
            background-color: white;
            color: black;
            padding: 15px;
            border-radius: 10px;
            display: inline-block;
            min-width: 250px;
            font-size: 18px;
        }
      
        .next-btn {
            margin-top: 40px;
            padding: 10px 20px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            cursor: pointer;
            border-radius: 5px;
        }

        .next-btn:hover {
            background-color: #e63973;
            color: white;
            border: 2px solid #e63973;
        }

    </style>

    <script>
        {% if not isHost %}
        //client waits for host to advance
        const protocol = location.protocol === "https:" ? "wss:" : "ws:";
        const socket = new WebSocket(protocol + "//" + location.host + "/game/{{ gameId }}");

        socket.onmessage = function(event) {
            const data = JSON.parse(event.data);
            if(data.redirect) {
                window.location.href = data.redirect
            }
        }

        socket.onerror = function(error) {
            console.log("WebSocket Error: " + error);
        }
        {% endif %}
    </script>

</head>

<body>
  
<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="question-title">
        Question {{ questionNumber }}:
    </div>

    <div class="question-box">
        {{ questionText }}
    </div>

    <div class="answer-label">
        Correct Answer:
    </div>

    <div class="answer-box">
        {{ correctAnswer }}
    </div>
    
    {% if isHost %}
    <form method="post" action="/show-positions/{{ gameId }}">
        <button type="submit" class="next-btn">Next</button>
    </form>
    {% endif %}

</div>

</body>
</html>