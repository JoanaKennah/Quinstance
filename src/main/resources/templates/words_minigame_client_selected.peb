<!DOCTYPE html>
<html lang="en">
<head>
    <title>Words</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2DC84D;
        }

        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: calc(100vh - 44px);
        }

        .card {
            border: 3px solid #2DC84D;
            border-radius: 20px;
            padding: 50px 80px;
            text-align: center;
            min-width: 340px;
        }

        .title {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .word-box {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 18px 40px;
            font-size: 22px;
            font-weight: bold;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }

        .logout-btn {
            color: white;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: calc(100vh - 44px);
        }

        .card {
            border: 3px solid #d33469;
            border-radius: 20px;
            padding: 50px 80px;
            text-align: center;
            min-width: 340px;
        }

        .title {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .word-box {
            border: 2px solid #d33469;
            border-radius: 10px;
            padding: 18px 40px;
            font-size: 22px;
            font-weight: bold;
        }
    </style>
    {% endif %}
</head>
<body>
    <div class="navbar">
        <a href="/quit-game" style="color: black; text-decoration: none; font-weight: bold;">Quit</a>
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">
        <div class="card">
            <div class="title">You submitted:</div>
            <div class="word-box">{{ word }}</div>
        </div>
    </div>

    <script>
        // poll for minigame end every 500ms
        const poll = setInterval(() => {
            fetch("/minigame-active/{{ gameId }}")
                .then(r => r.json())
                .then(data => {
                    if (!data.active) {
                        clearInterval(poll);
                        window.location.href = "/words-result/{{ gameId }}";
                    }
                })
                .catch(err => console.log("Poll error: " + err));
        }, 500);
    </script>
</body>
</html>