<!DOCTYPE html>
<html lang="en">
<head>
    <title>Sign Up</title>
    <style>

        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 0;
        }

        .navbar {
            background-color: #20882E;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        h1 {
            color: black;
            font-weight: bold;
        }

        .row {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 20px;
        }

        .field {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        select {
            padding: 5px 10px;
            background-color: white;
            color: black;
            border: 2px solid #176321;
            cursor: pointer;
            border-radius: 5px;
        }

        label {
            color: #20882E;
            font-weight: bold;
        }

        input, select {
            width: 200px;
            margin-top: 5px;
            border: 1px solid #176321;
        }

        .full-width input {
            width: 447px;
        }

        .single {
            margin-top: 20px;
            display: flex;
            justify-content: center;
        }
        
        .switch-text {
            text-align: center;
            font-size: 16px;
            margin-top: 20px;
            color: black;
            font-weight: normal;
        }

        .switch-link {
            color: #551A8B;
            text-decoration: none;
            font-weight: normal;
            font-size: 15px;
        }

        .switch-link:hover {
            text-decoration: underline;
        }
        button {
            margin-top: 25px;
            padding: 10px 25px;
            background-color: #176321;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background-color: #20882E;
            color: white;
        }

    </style>

    <script>
        function checkPasswords() {
            console.log("hi")
            var userPass = document.getElementById("password").value;
            var confirmedPass = document.getElementById("confirmedPassword").value;

            if (userPass != confirmedPass) {
                alert("Passwords must be equal");
                return false;
            }
            return true;
        }
    </script>
</head>

<body>

<div class="navbar">
    <a href="/home">Home</a>
</div>

<h1>Join Us!</h1>

<form method="post" action="/signup" onsubmit="return checkPasswords()">

    <div class="row">
        <div class="field">
            <label>First Name:</label>
            <input type="text" name="firstname" required>
        </div>
        <div class="field">
            <label>Last Name:</label>
            <input type="text" name="lastname" required>
        </div>
    </div>

    <div class="single">
        <div class="field full-width" style="align-items:center;">
            <label>Email Address:</label>
            <input type="email" name="email" required>
        </div>
    </div>

    <div class="row">
        <div class="field">
            <label>Key Stage:</label>
            <select name="keystage">
                <option value="">Select...</option>
                <option value="keystageone">KS1</option>
                <option value="keystagetwo">KS2</option>
                <option value="keystagethree">KS3</option>
                <option value="keystagefour">KS4</option>
                <option value="keystagefive">KS5</option>
                <option value="furthereducation">Further Education</option>
                <option value="nonapplicable">N/A</option>
            </select>
        </div>
        <div class="field">
            <label>Role:</label>
            <select name="role">
                <option value="">Select...</option>
                <option value="student">Student</option>
                <option value="teacher">Teacher</option>
            </select>
        </div>
    </div>

    <div class="single">
        <div class="field full-width" style="align-items:center;">
            <label>Username:</label>
            <input type="text" name="username" required>
        </div>
    </div>

    <div class="row">
        <div class="field">
            <label>Password:</label>
            <input type="password" name="password" id="password" required>
        </div>
        <div class="field">
            <label>Confirm Password:</label>
            <input type="password" name="confirmpassword" id="confirmedPassword" required>
        </div>
    </div>

    <button type="submit">Enter</button>

<p class="switch-text">Already have an account? <a href="/login" class="switch-link">Log in here</a></p>

</form>

</body>
</html>