<!DOCTYPE html>
<html lang="en">
<head>
    <title>Login</title>
    <style>

        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 0;
        }

        .navbar {
            background-color: #20882E;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        h1 {
            color: black;
            font-weight: bold;
        }

        label {
            color: #20882E;
            font-weight: bold;
            display: block;
            margin-top: 20px;
        }

        input {
            width: 250px;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
        }

        .forgot {
            font-size: 12px;
            margin-top: 8px;
        }

        .forgot a {
            color: #176321;
            text-decoration: underline;
        }

        .forgot a:hover {
            color: green;
        }

        .switch-text {
            text-align: center;
            font-size: 16px;
            margin-top: 20px;
            color: black;
            font-weight: normal;
        }

        .switch-link {
            color: #551A8B;
            text-decoration: none;
            font-weight: normal;
            font-size: 15px;
        }

        .switch-link:hover {
            text-decoration: underline;
        }

        button {
            margin-top: 25px;
            padding: 10px 25px;
            background-color: #176321;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background-color: #20882E;
            color: white;
        }
    
    </style>
</head>

<body>

<div class="navbar">
<a href="/home">Home</a>
</div>

<h1>Welcome Back!<h1>

<form method="post" action="/login">

    <label>Username:</label>
    <input type="text" name="username" required>

    <label>Password:</label>
    <input type="password" name="password" required>

    <div class="forgot">
        <a href="/forgot-password">Forgot Password?</a>
    </div>

    <button type="submit">Enter</button>


<p class="switch-text">Don’t have an account? <a href="/signup" class="switch-link">Sign up</a></p>

</form>

</body>
</html>