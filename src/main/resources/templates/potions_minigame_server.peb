<!DOCTYPE html>
<html lang="en">
<head>
    <title>Potions</title>

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2DC84D;
        }

        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 25px;
        }

        .title-box {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: black;
            color: #2DC84D;
            border: 2px solid #2DC84D;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #2DC84D;
            color: black;
        }

        .description {
            border: 2px solid #2DC84D;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .countdown {
            font-size: 60px;
            font-weight: bold;
            margin: 20px 0;
        }

        .arena {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 0;
        }

        .username-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            width: 130px;
            height: 100px;
            gap: 6px;
            padding-bottom: 160px;
        }

        .username {
            font-size: 16px;
            font-weight: bold;
            color: #2DC84D;
        }

        .trophy-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            height: 130px;
            position: relative;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .top-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            margin-bottom: 25px;
        }

        .title-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px 30px;
            display: inline-block;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
        }

        .btn-next {
            justify-self: end;
            padding: 6px 14px;
            font-size: 14px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-next:hover {
            background-color: #e63973;
            color: white;
        }

        .description {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .countdown {
            font-size: 60px;
            font-weight: bold;
            color: #e63973;
            margin: 20px 0;
        }

        .arena {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 0;
        }

        .username-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            width: 130px;
            height: 100px;
            gap: 6px;
            padding-bottom: 160px;
        }

        .username {
            font-size: 16px;
            font-weight: bold;
        }

        .trophy-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            height: 130px;
            position: relative;
        }
    </style>
    {% endif %}
</head>

<body onload='startTimer();'>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">

        <div class="top-row">
            <div></div>
            <div class="title-box">
                <h1>Potions</h1>
            </div>
            {% if isReveal %}
                <form method="post" action="/next-question/{{ gameId }}">
                    <button type="submit" class="btn-next">Next</button>
                </form>
            {% else %}
                <div></div>
            {% endif %}
        </div>

        <div class="description">
            {% if isReveal %}
                Uh oh! You drank the GHOST potion! Those highlighted are now ghosts!
            {% else %}
                Pick a potion, any potion!
            {% endif %}
        </div>

        {% if not isReveal %}
            <div class="countdown" id="timer">30</div>
        {% endif %}

        <div class="arena">

            <!-- Trophy 1 -->
            <div class="trophy-col">
                <svg width="130" height="130" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <!-- graphics from svgrepo -->
                    <path fill="#2DC84D" d="M422.002,58.284V29.349H92.734v28.935H0v18.346c0,0,0,43.236,0,86.473c0.027,14.526,4.328,29.349,11.986,43.588h0.004c11.528,21.33,30.854,41.646,57.305,57.151l0.399,0.234l-0.395-0.234c25.807,15.102,58.482,25.475,97.094,27.444l34.738,42.166v0.009c7.268,8.818,11.106,19.515,11.111,30.509v26.76l-79.669,26.625v65.295h249.596v-16.98v-48.316l-79.674-26.625v-26.76c0.004-10.994,3.843-21.691,11.111-30.509l34.926-42.383c50.423-3.164,90.478-20.719,118.223-44.207h-0.004c14.409-12.189,25.569-25.933,33.254-40.18h0.004c7.664-14.239,11.965-29.062,11.992-43.579c0-21.618,0-43.246,0-59.453c0-8.117,0-14.876,0-19.596c0-4.738,0-7.425,0-7.434V58.284H422.002z M65.961,222.386c-11.551-9.771-20.14-20.53-25.74-30.922c-5.618-10.383-8.166-20.36-8.144-28.36c0-21.609,0-43.237,0-59.444c0-4.998,0-9.484,0-13.286h65.26v59.175c-0.004,32.881,11.595,64.782,32.787,90.491l13.712,16.648C110.388,251.087,84.428,237.982,65.961,222.386z M290.971,314.801c-11.492,13.933-17.807,31.281-17.807,49.169v47.884l79.674,26.626v14.841H161.899V438.48l79.674-26.626v-47.884c0.009-17.888-6.314-35.236-17.808-49.16l-74.558-90.501c-17.632-21.403-27.142-47.695-27.142-74.76V58.671h270.612v90.878c-0.005,27.066-9.515,53.358-27.146,74.76L290.971,314.801z M479.918,163.104c0.023,8.001-2.521,17.978-8.143,28.36c-8.392,15.586-23.529,31.974-45.282,44.684c-15.168,8.88-33.546,16.008-55.142,19.99l13.263-16.099c21.201-25.709,32.796-57.61,32.787-90.491V90.374h62.518C479.918,106.555,479.918,134.825,479.918,163.104z"/>
                    <text x="256" y="220" text-anchor="middle" fill="white" font-size="180" font-weight="bold">1</text>
                </svg>
                {% if isReveal and ghostTrophy == 1 %}
                    <svg style="position: absolute; top: -10px; left: -15px; pointer-events: none;"
                         width="110" height="110" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                        <path fill="white" d="M417.913,490.426c-0.385-0.138-38.763-14.23-55.472-58.08c-14.151-37.133-6.785-79.476,19.224-110.507c14.821-17.682,63.176-79.533,63.176-132.999C444.84,84.714,360.127,0,256.001,0S67.161,84.714,67.161,188.84c0,69.232,32.57,145.853,87.125,204.963c45.579,49.385,127.55,109.975,259.215,118.176c0.234,0.014,0.467,0.022,0.699,0.022c5.239,0,9.811-3.685,10.875-8.88C426.183,497.695,423.129,492.281,417.913,490.426z M170.611,378.734c-50.867-55.113-81.234-126.102-81.234-189.895c0-91.876,74.747-166.623,166.623-166.623s166.623,74.747,166.623,166.623c0,36.528-29.954,85.282-57.986,118.728c-31.175,37.196-39.972,88.039-22.957,132.689c7.327,19.227,18.055,33.74,28.872,44.473C271.864,468.026,208.092,419.344,170.611,378.734z M234.291,141.511c0-23.67-14.638-42.211-33.325-42.211c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.637,42.211,33.325,42.211C219.652,183.722,234.291,165.181,234.291,141.511z M200.966,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C212.074,152.955,206.21,161.506,200.966,161.506z M305.382,99.3c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.638,42.211,33.325,42.211s33.325-18.541,33.325-42.211C338.707,117.84,324.07,99.3,305.382,99.3z M305.382,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C316.49,152.955,310.626,161.506,305.382,161.506z M253.174,201.495c-22.356,0-40.545,18.189-40.545,40.545v32.214c0,22.356,18.189,40.545,40.545,40.545c22.355,0,40.545-18.189,40.545-40.545V242.04C293.719,219.684,275.53,201.495,253.174,201.495z M271.502,274.254c0,10.106-8.221,18.329-18.329,18.329c-10.106,0-18.329-8.222-18.329-18.329V242.04c0-10.106,8.222-18.329,18.329-18.329c10.106,0,18.329,8.222,18.329,18.329V274.254z M361.099,257.152c1.806,1.102,3.802,1.626,5.773,1.626c3.746,0,7.401-1.895,9.494-5.326c15.503-25.419,24.04-48.366,24.04-64.613c0-6.135-4.974-11.108-11.108-11.108c-6.134,0-11.108,4.973-11.108,11.108c0,11.869-7.772,31.698-20.791,53.045C354.205,247.121,355.862,253.957,361.099,257.152z"/>
                    </svg>
                {% endif %}
            </div>

            <div class="username-col" id="col1">
                {% for user in col1_users %}
                    <div class="username" {% if isReveal and isGhostCol1 %}style="color: white;"{% endif %}>{{ user }}</div>
                {% endfor %}
            </div>

            <!-- Trophy 2 -->
            <div class="trophy-col">
                <svg width="130" height="130" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#2DC84D" d="M422.002,58.284V29.349H92.734v28.935H0v18.346c0,0,0,43.236,0,86.473c0.027,14.526,4.328,29.349,11.986,43.588h0.004c11.528,21.33,30.854,41.646,57.305,57.151l0.399,0.234l-0.395-0.234c25.807,15.102,58.482,25.475,97.094,27.444l34.738,42.166v0.009c7.268,8.818,11.106,19.515,11.111,30.509v26.76l-79.669,26.625v65.295h249.596v-16.98v-48.316l-79.674-26.625v-26.76c0.004-10.994,3.843-21.691,11.111-30.509l34.926-42.383c50.423-3.164,90.478-20.719,118.223-44.207h-0.004c14.409-12.189,25.569-25.933,33.254-40.18h0.004c7.664-14.239,11.965-29.062,11.992-43.579c0-21.618,0-43.246,0-59.453c0-8.117,0-14.876,0-19.596c0-4.738,0-7.425,0-7.434V58.284H422.002z M65.961,222.386c-11.551-9.771-20.14-20.53-25.74-30.922c-5.618-10.383-8.166-20.36-8.144-28.36c0-21.609,0-43.237,0-59.444c0-4.998,0-9.484,0-13.286h65.26v59.175c-0.004,32.881,11.595,64.782,32.787,90.491l13.712,16.648C110.388,251.087,84.428,237.982,65.961,222.386z M290.971,314.801c-11.492,13.933-17.807,31.281-17.807,49.169v47.884l79.674,26.626v14.841H161.899V438.48l79.674-26.626v-47.884c0.009-17.888-6.314-35.236-17.808-49.16l-74.558-90.501c-17.632-21.403-27.142-47.695-27.142-74.76V58.671h270.612v90.878c-0.005,27.066-9.515,53.358-27.146,74.76L290.971,314.801z M479.918,163.104c0.023,8.001-2.521,17.978-8.143,28.36c-8.392,15.586-23.529,31.974-45.282,44.684c-15.168,8.88-33.546,16.008-55.142,19.99l13.263-16.099c21.201-25.709,32.796-57.61,32.787-90.491V90.374h62.518C479.918,106.555,479.918,134.825,479.918,163.104z"/>
                    <text x="256" y="220" text-anchor="middle" fill="white" font-size="180" font-weight="bold">2</text>
                </svg>
                {% if isReveal and ghostTrophy == 2 %}
                    <svg style="position: absolute; top: -10px; left: -15px; pointer-events: none;"
                         width="110" height="110" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                        <path fill="white" d="M417.913,490.426c-0.385-0.138-38.763-14.23-55.472-58.08c-14.151-37.133-6.785-79.476,19.224-110.507c14.821-17.682,63.176-79.533,63.176-132.999C444.84,84.714,360.127,0,256.001,0S67.161,84.714,67.161,188.84c0,69.232,32.57,145.853,87.125,204.963c45.579,49.385,127.55,109.975,259.215,118.176c0.234,0.014,0.467,0.022,0.699,0.022c5.239,0,9.811-3.685,10.875-8.88C426.183,497.695,423.129,492.281,417.913,490.426z M170.611,378.734c-50.867-55.113-81.234-126.102-81.234-189.895c0-91.876,74.747-166.623,166.623-166.623s166.623,74.747,166.623,166.623c0,36.528-29.954,85.282-57.986,118.728c-31.175,37.196-39.972,88.039-22.957,132.689c7.327,19.227,18.055,33.74,28.872,44.473C271.864,468.026,208.092,419.344,170.611,378.734z M234.291,141.511c0-23.67-14.638-42.211-33.325-42.211c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.637,42.211,33.325,42.211C219.652,183.722,234.291,165.181,234.291,141.511z M200.966,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C212.074,152.955,206.21,161.506,200.966,161.506z M305.382,99.3c-18.686,0-33.325,18.541-33.325,42.211c0,23.671,14.638,42.211,33.325,42.211s33.325-18.541,33.325-42.211C338.707,117.84,324.07,99.3,305.382,99.3z M305.382,161.506c-5.244,0-11.108-8.551-11.108-19.995c0-11.444,5.864-19.995,11.108-19.995s11.108,8.551,11.108,19.995C316.49,152.955,310.626,161.506,305.382,161.506z M253.174,201.495c-22.356,0-40.545,18.189-40.545,40.545v32.214c0,22.356,18.189,40.545,40.545,40.545c22.355,0,40.545-18.189,40.545-40.545V242.04C293.719,219.684,275.53,201.495,253.174,201.495z M271.502,274.254c0,10.106-8.221,18.329-18.329,18.329c-10.106,0-18.329-8.222-18.329-18.329V242.04c0-10.106,8.222-18.329,18.329-18.329c10.106,0,18.329,8.222,18.329,18.329V274.254z M361.099,257.152c1.806,1.102,3.802,1.626,5.773,1.626c3.746,0,7.401-1.895,9.494-5.326c15.503-25.419,24.04-48.366,24.04-64.613c0-6.135-4.974-11.108-11.108-11.108c-6.134,0-11.108,4.973-11.108,11.108c0,11.869-7.772,31.698-20.791,53.045C354.205,247.121,355.862,253.957,361.099,257.152z"/>
                    </svg>
                {% endif %}
            </div>

            <div class="username-col" id="col2">
                {% for user in col2_users %}
                    <div class="username" {% if isReveal and isGhostCol2 %}style="color: white;"{% endif %}>{{ user }}</div>
                {% endfor %}
            </div>

            <!-- Trophy 3 -->
            <div class="trophy-col">
                <svg width="130" height="130" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#2DC84D" d="M422.002,58.284V29.349H92.734v28.935H0v18.346c0,0,0,43.236,0,86.473c0.027,14.526,4.328,29.349,11.986,43.588h0.004c11.528,21.33,30.854,41.646,57.305,57.151l0.399,0.234l-0.395-0.234c25.807,15.102,58.482,25.475,97.094,27.444l34.738,42.166v0.009c7.268,8.818,11.106,19.515,11.111,30.509v26.76l-79.669,26.625v65.295h249.596v-16.98v-48.316l-79.674-26.625v-26.76c0.004-10.994,3.843-21.691,11.111-30.509l34.926-42.383c50.423-3.164,90.478-20.719,118.223-44.207h-0.004c14.409-12.189,25.569-25.933,33.254-40.18h0.004c7.664-14.239,11.965-29.062,11.992-43.579c0-21.618,0-43.246,0-59.453c0-8.117,0-14.876,0-19.596c0-4.738,0-7.425,0-7.434V58.284H422.002z M65.961,222.386c-11.551-9.771-20.14-20.53-25.74-30.922c-5.618-10.383-8.166-20.36-8.144-28.36c0-21.609,0-43.237,0-59.444c0-4.998,0-9.484,0-13.286h65.26v59.175c-0.004,32.881,11.595,64.782,32.787,90.491l13.712,16.648C110.388,251.087,84.428,237.982,65.961,222.386z M290.971,314.801c-11.492,13.933-17.807,31.281-17.807,49.169v47.884l79.674,26.626v14.841H161.899V438.48l79.674-26.626v-47.884c0.009-17.888-6.314-35.236-17.808-49.16l-74.558-90.501c-17.632-21.403-27.142-47.695-27.142-74.76V58.671h270.612v90.878c-0.005,27.066-9.515,53.358-27.146,74.76L290.971,314.801z M479.918,163.104c0.023,8.001-2.521,17.978-8.143,28.36c-8.392,15.586-23.529,31.974-45.282,44.684c-15.168,8.88-33.546,16.008-55.142,19.99l13.263-16.099c21.201-25.709,32.796-57.61,32.787-90.491V90.374h62.518C479.918,106.555,479.918,134.825,479.918,163.104z"/>
                    <text x="256" y="220" text-anchor="middle" fill="white" font-size="180" font-weight="bold">3</text>
                </svg>
                {% if isReveal and ghostTrophy == 3 %}
                    <svg style="position: absolute; top: -10px; left: -15px; pointer-events: none;"
                         width="110" height="110" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
