                    </svg>
                {% endif %}
            </div>

            <div class="username-col" id="col3">
                {% for user in col3_users %}
                    <div class="username" {% if isReveal and isGhostCol3 %}style="color: white;"{% endif %}>{{ user }}</div>
                {% endfor %}
            </div>

            <!-- Trophy 4 -->
            <div class="trophy-col">
                <svg width="130" height="130" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
