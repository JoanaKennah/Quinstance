                    <text x="256" y="220" text-anchor="middle" fill="white" font-size="180" font-weight="bold">4</text>
                </svg>
                {% if isReveal and ghostTrophy == 4 %}
                    <svg style="position: absolute; top: -10px; left: -15px; pointer-events: none;"
                         width="110" height="110" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
