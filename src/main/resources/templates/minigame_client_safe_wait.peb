<!DOCTYPE html>
<html lang="en">
<head>
    <title>You're Safe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2dc84d;
        }

        .navbar {
            background-color: #2dc84d;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .container {
            text-align: center;
            margin-top: 100px;
        }

        .box {
            border: 2px solid #2dc84d;
            border-radius: 10px;
            padding: 30px;
            display: inline-block;
        }

        h1 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        .score-label {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .score {
            font-size: 40px;
            font-weight: bold;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }
    </style>

    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            color: black;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .container {
            text-align: center;
            margin-top: 100px;
        }

        .box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 30px;
            display: inline-block;
        }

        h1 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        .score-label {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .score {
            font-size: 40px;
            font-weight: bold;
            color: #e63973;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="container">
        <div class="box">
            <h1>You are safe!</h1>
            <div class="score-label">Total Score:</div>
            <div class="score">{{ score }}</div>
        </div>
    </div>

    <script>
        const pollRedirect = setInterval(() => {
            fetch("/minigame-redirect/{{ gameId }}")
                .then(r => r.json())
                .then(data => {
                    if (data.redirect !== null) {
                        clearInterval(pollRedirect);
                        window.location.href = data.redirect;
                    }
                })
                .catch(err => console.log("Poll error: " + err));
        }, 500);
    </script>
</body>
</html>