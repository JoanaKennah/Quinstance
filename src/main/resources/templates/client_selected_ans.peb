<!DOCTYPE html>
<html lang="en">
<head>
    <title>Selected Answer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
        }
        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }
        .content {
            margin: 40px;
            text-align: center;
        }
        .title {
            color: #2DC84D;
            font-size: 28px;
            margin-bottom: 20px;
        }
        .answer-box {
            border: 4px solid #2DC84D;
            background-color: black;
            color: #2DC84D;
            padding: 20px;
            border-radius: 10px;
            display: inline-block;
            min-width: 300px;
            font-size: 18px;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title {
            color: black;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .answer-box {
            border: 4px solid #d33469;
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            display: inline-block;
            min-width: 300px;
            font-size: 18px;
        }
    </style>
    {% endif %}

</head>

<script>

    //connect to game, wait for server to advance to next Q
    const protocol = location.protocol === "https:" ? "wss:" : "ws:";
    const socket = new WebSocket(protocol + "//" + location.host + "/game/{{ gameId }}");

    socket.onmessage = function(event) {
        const data = JSON.parse(event.data);
        if (data.redirect && !data.redirect.startsWith("/selected-answer")) {
            window.location.href = data.redirect;
        }
    }

    socket.onerror = function(error) {
        console.log("WebSocket error: " + error);
    }

</script>

<body>

<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="title">
        You selected:
    </div>

    <div class="answer-box">
        {{ selectedAnswer }}
    </div>

</div>

</body>
</html>