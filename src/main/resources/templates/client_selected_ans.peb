<!DOCTYPE html>
<html lang="en">
<head>
    <title>Selected Answer</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title {
            color: black;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .answer-box {
            border: 4px solid #e63973;
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            display: inline-block;
            min-width: 300px;
            font-size: 18px;
        }
    </style>

</head>

<script>

    //connect to game, wait for server to advance to next Q
    const protocol = location.protocol === "https:" ? "wss:" : "ws:";
    const socket = new WebSocket(protocol + "//" + location.host + "/game/{{ gameId }}");

    socket.onmessage = function(event) {
        const data = JSON.parse(event.data);
        if (data.redirect) {
            window.location.href = data.redirect;
        }
    }

    socket.onerror = function(error) {
        console.log("WebSocket error: " + error);
    }

</script>

<body>

<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="title">
        You selected:
    </div>

    <div class="answer-box">
        {{ selectedAnswer }}
    </div>

</div>

</body>
</html>