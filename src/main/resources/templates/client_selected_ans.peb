<!DOCTYPE html>
<html lang="en">
<head>
    <title>Selected Answer</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title {
            color: black;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .answer-box {
            border: 4px solid #e63973;
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            display: inline-block;
            min-width: 300px;
            font-size: 18px;
        }
    </style>

</head>

<body>

<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content"> <!--- NEED TO COORDINATE ROUTING TO CHANGE WHEN SERVER SIDE CHANGES --->

    <div class="title">
        You selected:
    </div>

    <div class="answer-box">
        {{ selectedAnswer }}
    </div>

</div>

</body>
</html>