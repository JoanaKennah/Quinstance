<!DOCTYPE html>
<html lang="en">
<head>
    <title>Quiz Created</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            text-align: center;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        h1 {
            color: black;
            margin-top: 40px;
        }

        .button-container {
            margin-top: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        button {
            background-color: #d6285f;
            padding: 15px;
            font-size: 16px;
            cursor: pointer;
            color: white;
            width: 260px;
            transition: 0.2s;
            border: none;
        }

        button:hover {
            background-color: #b02a57;
            color: white;
        }

    </style>
</head>

<body>

<div class="navbar">
<a>Quiz Creation</a>
</div>

<h1>Quiz Created!</h1>

<div class="button-container"> <!--- NEED TO ADD ROUTING --->
<button onclick="window.location.href='/create-lobby/{{ quizId }}'">Create a Lobby</button>
<button onclick="window.location.href='/view-quizzes'">View Quizzes</button>
<button onclick="window.location.href='{{ returnURL }}'">Return to Dashboard</button>
</div>

</body>
</html>