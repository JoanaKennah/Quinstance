<!DOCTYPE html>
<html lang="en">
<head>
    {% if isEdit %}
        <title>Edit Question</title>
    {% else %}
        <title>Create Question</title>
    {% endif %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
        }

        .title-box {
            border: 2px solid #e63973;
            background-color: white;
            padding: 20px;
            text-align: center;
            border-radius: 10px;
        }

        h1 {
            color: black;
            margin: 0;
        }

        .question-row {
            margin-top: 30px;
        }

        .question-row label {
            color: #e63973;
            font-weight: bold;
            margin-right: 10px;
        }

        .question-input {
            padding: 8px;
            width: 100%;
            box-sizing: border-box;
        }

        .answers {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
        }

        .column {
            width: 45%;
        }

        .answer-box {
            border: 2px solid #e63973;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            background-color: white;
        }

        .answer-box input[type="text"] {
            border: none;
            outline: none;
            flex-grow: 1;
        }

        .answer-box input[type="radio"] {
            margin-left: 10px;
        }

        .remove-btn {
            margin-right: 10px;
            background: none;
            border: none;
            cursor: pointer;
            color: #e63973;
            font-weight: bold;
            font-size: 16px;
            padding: 0;
        }

        .remove-btn:hover {
            background: none;
            color: inherit;
        }

        .bottom-bar {
            margin-top: 40px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .cancel {
            margin-right: 20px;
            text-decoration: none;
            color: black;
        }

        .cancel:hover {
            text-decoration: underline;
        }

        button {
            padding: 10px 20px;
            background-color: #e63973;
            color: white;
            border: none;
            cursor: pointer;
        }
      
        button:hover {
            background-color: #d6285f;
        }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

    </style>

    <script>
        let answerCount = 4;

        function removeAnswer(id) {
            const el = document.getElementById(id);
            el.remove();
            answerCount--;
        }

        function addAnswer() {
            if (answerCount >=4) {
                alert("Maximum 4 answers allowed");
                return;
            }

            // makes sure that "add answer" adds the lowest available answer index
            let newIndex = 1;
            while (document.getElementById("a" + newIndex)) {
                newIndex++;
            }

            answerCount++;

            const cols = document.querySelectorAll(".column");
            const col = (newIndex % 2 === 0) ? cols[1] : cols[0];

            const div = document.createElement("div");
            div.className = "answer-box";
            div.id = "a" + newIndex;
            div.innerHTML = `
                <button type="button" class="remove-btn" onclick="removeAnswer('a${newIndex}')">x</button>
                <input type="text" name="answers[]" placeholder="Answer ${newIndex}">
                <input type="radio" name="correct" value="${newIndex - 1}">
            `;
            col.appendChild(div);
        }

        function validateForm() {
            const question = document.getElementById("question").value.trim();
            const answers = document.querySelectorAll(".answer-box input[type='text']");
            const checked = document.querySelectorAll("input[name='correct']:checked");

            let filledAnswers = 0;
            let trimmedAnswers = [];
            answers.forEach(a => {
                if (a.value.trim() !== "") filledAnswers++;
                trimmedAnswers.push(a.value.trim())
            });

            if (question === "") {
                alert("Question must be filled in.");
                return false;
            }

            if (filledAnswers < 2) {
                alert("You must have at least 2 answers.");
                return false;
            }

            if (checked.length !== 1) {
                alert("Please select exactly one correct answer.");
                return false;
            }

            let removedRepeats = new Set(trimmedAnswers);

            if (trimmedAnswers.length != removedRepeats.size) {
                alert("You cannot have repeated answers");
                return false;
            }

            return true;
        }
    </script>
</head>

<body>

<div class="navbar">
  <a>Quiz Creation</a>
</div>

<div class="content">

    <div class="title-box">
        <h1>{{ quizName }}</h1>
    </div>

    <form method="post" action="/add-question/{{ quizId }}" onsubmit="return validateForm()"> <!--- NEED TO CHECK AFTER ROUTING --->

        <div class="question-row">
            <label for="question">Question:</label>
            <input type="text" id="question" value='{{ previousQuestionText }}' name="question" class="question-input" required>
        </div>

        <div class="answers">
            <div class="column">
                <div class="answer-box" id="a1">
                    <label for="answer1" class="visually-hidden">Answer 1</label>
                    <input type="text" id="answer1" value='{{ previousCorrectAnswer }}' name="answers[]" placeholder="Answer 1">

                    <input type="radio" id="correct1" name="correct" value="0"
                        {% if isEdit %}checked{% endif %}>
                    <label for="correct1" class="visually-hidden">Mark Answer 1 as correct</label>
                </div>

                <div class="answer-box" id="a3">
                    <button type="button" class="remove-btn" onclick="removeAnswer('a3')">x</button>

                    <label for="answer3" class="visually-hidden">Answer 3</label>
                    <input type="text" id="answer3" value='{{ previousOption3 }}' name="answers[]" placeholder="Answer 3">

                    <input type="radio" id="correct3" name="correct" value="2">
                    <label for="correct3" class="visually-hidden">Mark Answer 3 as correct</label>
                </div>

            </div>

            <div class="column">

                <div class="answer-box" id="a2">
                    <label for="answer2" class="visually-hidden">Answer 2</label>
                    <input type="text" id="answer2" value='{{ previousOption2 }}' name="answers[]" placeholder="Answer 2">

                    <input type="radio" id="correct2" name="correct" value="1">
                    <label for="correct2" class="visually-hidden">Mark Answer 2 as correct</label>
                </div>

                <div class="answer-box" id="a4">
                    <button type="button" class="remove-btn" onclick="removeAnswer('a4')">x</button>

                    <label for="answer4" class="visually-hidden">Answer 4</label>
                    <input type="text" id="answer4" value='{{ previousOption4 }}' name="answers[]" placeholder="Answer 4">

                    <input type="radio" id="correct4" name="correct" value="3">
                    <label for="correct4" class="visually-hidden">Mark Answer 4 as correct</label>
                </div>

            </div>

        </div>

        <div style="margin-top: 15px;">
            <button type="button" onclick="addAnswer()">+ Add Answer</button>
        </div>

        {% if isEdit %}
            <input type="hidden" name="isEdit" value="true">
            <input type="hidden" name="questionId" value={{ questionId }}>
        {% endif %}

        <div class="bottom-bar">

            <a class="cancel" href="/view-quiz-questions/{{ quizId }}">Cancel</a> <!--- NEED TO ADD ROUTING --->

            {% if isEdit %}
                <button type="submit">Edit</button> <!--- NEED TO ADD ROUTING --->
            {% else %}
                <button type="submit">Create</button>
            {% endif %}

        </div>

    </form>

</div>

</body>
</html>