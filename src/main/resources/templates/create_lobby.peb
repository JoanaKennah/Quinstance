<!DOCTYPE html>
<html lang="en">
<head>
    <title>Create a Lobby</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
        }

        .title-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            margin-bottom: 40px;
        }

        .title-box h1 {
            margin: 0;
            font-size: 32px;
            color: black;
        }

        .container {
            display: flex;
            justify-content: space-between;
            gap: 30px;
        }

        .left, .right {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 25px;
            width: 45%;
        }

        .detail {
            color: #e63973;
            font-weight: bold;
            font-size: 18px;
            margin-top: 20px;
        }

        .detail:first-child {
            margin-top: 0;
        }

        .detail-value {
            font-size: 16px;
            color: black;
            margin-top: 5px;
        }

        .right h2 {
            text-align: center;
            text-decoration: underline;
            color: black;
            margin-top: 0;
        }

        .time-label {
            font-size: 16px;
            color: black;
            margin-bottom: 10px;
        }

        .time-options {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .time-btn {
            padding: 8px 16px;
            border: 2px solid #e63973;
            border-radius: 6px;
            background-color: white;
            color: black;
            cursor: pointer;
            font-size: 14px;
        }

        .time-btn:hover, .time-btn.selected {
            background-color: #e63973;
            color: white;
        }

        .minigame-btn {
            padding: 8px 16px;
            border: 2px solid #e63973;
            border-radius: 6px;
            background-color: white;
            color: black;
            cursor: pointer;
            font-size: 14px;
        }

        .minigame-btn.selected {
            background-color: #e63973;
            color: white;
        }

        .bottom-bar {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
        }

        .btn {
            padding: 14px 28px;
            font-size: 16px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            cursor: pointer;
            border-radius: 6px;
        }

        .btn:hover {
            background-color: #e63973;
            color: white;
        }
    </style>

    <script>
        function selectTime(element, seconds) {
            document.querySelectorAll(".time-btn").forEach(btn => {
                btn.classList.remove("selected");
            });
            element.classList.add("selected");
            document.getElementById("timeLimit").value = seconds;
        }

        function toggleMinigames() {
            const toggle = document.getElementById("minigamesToggle");
            const options = document.getElementById("minigameOptions");
            options.style.display = toggle.checked ? "block" : "none";
        }

        function toggleMinigame(btn, game) {
            btn.classList.toggle("selected");
            const input = document.getElementById(game + "-input");
            input.disabled = !btn.classList.contains("selected");
        }
    </script>
</head>

<body>

<div class="navbar">
    <a>Create a Lobby</a>
</div>

<div class="content">

    <div class="title-box">
        <h1>Create a Lobby</h1>
    </div>

    <form method="post" action="/create-lobby/{{ quizId }}">

        <input type="hidden" id="timeLimit" name="timeLimit" value="30">

        <div class="container">

            <div class="left">
                <div class="detail">Quiz:</div>
                <div class="detail-value">{{ quizName }}</div>

                <div class="detail">Number of Questions:</div>
                <div class="detail-value">{{ numQuestions }}</div>

                <div class="detail">Category:</div>
                <div class="detail-value">{{ category }}</div>

                <div class="detail">Key Stage:</div>
                <div class="detail-value">{{ keyStage }}</div>
            </div>

            <div class="right">
                <h2>Settings</h2>

                <div class="time-label">Time to answer Questions:</div>
                <div class="time-options">
                    <button type="button" class="time-btn" onclick="selectTime(this, 15)">15s</button>
                    <button type="button" class="time-btn selected" onclick="selectTime(this, 30)">30s</button>
                    <button type="button" class="time-btn" onclick="selectTime(this, 60)">60s</button>
                    <button type="button" class="time-btn" onclick="selectTime(this, 0)">Unlimited</button>
                </div>

                <div style="margin-top: 20px; font-size: 16px; color: black;">
                    Spooky theme:
                    <input type="checkbox" name="theme" value="spooky" style="margin-left: 8px;">
                </div>

                <div style="margin-top: 20px; font-size: 16px; color: black;">
                    Mini Games:
                    <input type="checkbox" 
                        id="minigamesToggle" 
                        name="minigames" 
                        value="true" 
                        style="margin-left: 8px;"
                        onchange="toggleMinigames()"
                        {% if minigamesEnabled %}checked{% endif %}>
                </div>

                <div id="minigameOptions" style="margin-top: 10px; display: {% if minigamesEnabled %}block{% else %}none{% endif %};">
                    <div style="font-size: 14px; color: black; margin-bottom: 8px;">Select minigames:</div>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <button type="button" class="minigame-btn" onclick="toggleMinigame(this, 'maths')">Maths</button>
                        <button type="button" class="minigame-btn" onclick="toggleMinigame(this, 'potions')">Potions</button>
                        <button type="button" class="minigame-btn" onclick="toggleMinigame(this, 'rooms')">Rooms</button>
                        <button type="button" class="minigame-btn" onclick="toggleMinigame(this, 'words')">Words</button>
                    </div>

                    <input type="hidden" id="maths-input" name="activeMinigames" value="maths" disabled>
                    <input type="hidden" id="potions-input" name="activeMinigames" value="potions" disabled>
                    <input type="hidden" id="rooms-input" name="activeMinigames" value="rooms" disabled>
                    <input type="hidden" id="words-input" name="activeMinigames" value="words" disabled>
                </div>

            </div>

        </div>

        <div class="bottom-bar">
            <button type="button" class="btn" onclick="window.location.href='/view-quizzes'">
                Return to View Quizzes
            </button>
            <button type="submit" class="btn">Create Lobby!</button>
        </div>

    </form>

</div>

</body>
</html>