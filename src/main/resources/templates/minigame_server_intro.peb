<!DOCTYPE html>
<html lang="en">
<head>
    <title>Minigame</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2dc84d;
        }

        .navbar {
            background-color: #2dc84d;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .container {
            text-align: center;
            margin-top: 100px;
        }

        .box {
            border: 2px solid #2dc84d;
            border-radius: 10px;
            padding: 30px;
            display: inline-block;
        }

        h1 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        h2 {
            font-size: 28px;
            margin: 0;
        }

        .btn-start {
            margin-top: 30px;
            padding: 12px 40px;
            font-size: 18px;
            font-weight: bold;
            background-color: black;
            color: #2dc84d;
            border: 2px solid #2dc84d;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-start:hover {
            background-color: #2dc84d;
            color: black;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .rules {
            font-size: 16px;
            margin-top: 15px;
            max-width: 400px;
        }
    </style>

    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            color: black;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .container {
            text-align: center;
            margin-top: 100px;
        }

        .box {
            border: 2px solid #d33469;
            border-radius: 10px;
            padding: 30px;
            display: inline-block;
        }

        h1 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        h2 {
            font-size: 28px;
            margin: 0;
        }

        .btn-start {
            margin-top: 30px;
            padding: 12px 40px;
            font-size: 18px;
            font-weight: bold;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-start:hover, .btn-start:focus {
            background-color: #b02a57;
            color: white;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover, .logout-btn:focus {
            text-decoration: underline;
        }

        .rules {
            font-size: 16px;
            margin-top: 15px;
            max-width: 400px;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="container">
        <div class="box">
            <h1>Minigame Incoming:</h1>
            <h2>{{ minigameName }}</h2>
                <p class="rules">
                    {% if minigameName == "Maths" %}
                        Solve quick maths problems under time pressure to avoid becoming a ghost. Players who answered correctly can play along!
                    {% elseif minigameName == "Potions" %}
                        Choose the correct potion to avoid becoming a ghost.
                    {% elseif minigameName == "Rooms" %}
                        Choose a door; if everyone picks the same you all win, if not, everyone in the busiest room becomes a ghost!
                    {% elseif minigameName == "Words" %}
                        Create the longest word possible from the given letters to avoid becoming a ghost. Players who answered correctly can play along!
                    {% endif %}
                </p>
            <form method="post" action="{{ beginRoute }}">
                <button type="submit" class="btn-start">Start</button>
            </form>
        </div>
    </div>
</body>
</html>