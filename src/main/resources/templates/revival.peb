<!DOCTYPE html>
<html lang="en">
<head>
    <title>Revived!</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2dc84d;
        }

        .navbar {
            background-color: #2dc84d;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .container {
            text-align: center;
            margin-top: 100px;
        }

        .box {
            border: 2px solid #2dc84d;
            border-radius: 10px;
            padding: 30px;
            display: inline-block;
        }

        h1 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        .score-label {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .score {
            font-size: 40px;
            font-weight: bold;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }
    </style>

    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            color: black;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .container {
            text-align: center;
            margin-top: 100px;
        }

        .box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 30px;
            display: inline-block;
        }

        h1 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        .score-label {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .score {
            font-size: 40px;
            font-weight: bold;
            color: #e63973;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover, .logout-btn:focus {
            text-decoration: underline;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="container">
        <div class="box">
            <h1>You have been revived!</h1>
            <div class="score-label">Total Score:</div>
            <div class="score">{{ score }}</div>
        </div>
    </div>

    <script>
        const protocol = location.protocol === "https:" ? "wss:" : "ws:";
        const socket = new WebSocket(protocol + "//" + location.host + "/game/{{ gameId }}");

        socket.onmessage = function(event) {
            const data = JSON.parse(event.data);
            if (data.redirect) {
                window.location.href = data.redirect;
            }
        }

        socket.onerror = function(error) {
            console.log("WebSocket error: " + error);
        }
    </script>
    <script>
        //just in case - polls to check if player kicked
        const kickPoll = setInterval(() => {
            fetch("/is-kicked/{{ gameId }}")
                .then(response => response.json())
                .then(data => {
                    if (data.kicked) {
                        clearInterval(kickPoll);
                        window.location.href = "/kicked/{{ gameId }}";
                    }
                })
                .catch(err => console.log("Kick poll error: " + err));
        }, 1000);
    </script>
</body>
</html>