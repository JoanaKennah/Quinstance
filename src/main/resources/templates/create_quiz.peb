<!DOCTYPE html>
<html lang="en">
<head>
    <title>Create a Quiz</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
        }

        h1 {
            color: black;
            text-align: center;
        }

        .container {
            display: flex;
            justify-content: space-between;
        }

        .left, .right {
            width: 45%;
        }

        label {
            color: #e63973;
            font-weight: bold;
            display: block;
            margin-top: 15px;
        }

        input[type="text"], textarea, select {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        textarea {
            height: 100px;
        }

        .games-options {
            display: none;
            margin-top: 10px;
            font-size: 14px;
        }

        .bottom-bar {
            margin-top: 40px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .cancel {
            margin-right: 20px;
            text-decoration: none;
            color: black;
        }

        .cancel:hover {
            text-decoration: underline;
        }

        button {
            padding: 10px 20px;
            background-color: #e63973;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background-color: #d6285f;
        }
      
    </style>

    <script>
        function toggleMiniGames() {
            const toggle = document.getElementById("miniGamesToggle");
            const options = document.getElementById("gamesOptions");

            options.style.display = toggle.checked ? "block" : "none";
        }
    </script>
</head>

<body>

<div class="navbar">
  <a>Quiz Creation</a>
</div>

<div class="content">

<h1>Create a Quiz</h1>

<form method="post" action="/create-quiz">

    <div class="container">

        <div class="left">
            <label for="quizName">Quiz Name:</label>
            <input type="text" id="quizName" name="quizName" required>

            <label for="description">Description:</label>
            <textarea id="description" name="description" required></textarea>
        </div>

        <div class="right">
            <label for="keyStage">Key Stage:</label>
            <select id="keyStage" name="keystage" required>
                <option value="">Select...</option>
                <option value="KS1">KS1</option>
                <option value="KS2">KS2</option>
                <option value="KS3">KS3</option>
                <option value="KS4">KS4</option>
                <option value="KS5">KS5</option>
                <option value="furthereducation">Further Education</option>
                <optin value ="nonapplicable">N/A</option>
            </select>

            <label for="category">Category:</label>
            <select id="category" name="category" required>
                <option value="">Select...</option>
                <option value="art">Art and Design</option>
                <option value="biology">Biology</option>
                <option value="business">Business Studies</option>
                <option value="chemistry">Chemistry</option>
                <option value="cs">Computer Science</option>
                <option value="dt">Design and Technology</option>
                <option value="drama">Drama</option>
                <option value="eng_lang">English Language</option>
                <option value="eng_lit">English Literature</option>
                <option value="french">French</option>
                <option value="geography">Geography</option>
                <option value="german">German</option>
                <option value="history">History</option>
                <option value="latin">Latin</option>
                <option value="maths">Mathematics</option>
                <option value="media">Media Studies</option>
                <option value="music">Music</option>
                <option value="pe">Physical Education</option>
                <option value="physics">Physics</option>
                <option value="rs">Religious Studies</option>
                <option value="spanish">Spanish</option>
                <option value="other">Other</option>
                
            </select>
        </div>

    </div>

    <div class="bottom-bar">

        <a class="cancel" href={{ returnURL }}>Cancel</a>

        <button type="submit">Next</button>

    </div>

</form>
</div>

</body>
</html>