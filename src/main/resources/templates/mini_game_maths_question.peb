<!DOCTYPE html>
<html lang="en">
<head>
    <title>Maths Question</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2dc84d;
            text-align: center;
        }

        .navbar {
            background-color: #2dc84d;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
        }

        .question-box {
            border: 2px solid #2dc84d;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            display: block;
            width: 60%;
            margin-left: auto;
            margin-right: auto;
            font-size: 28px;
        }

        .answers {
            display: grid;
            grid-template-columns: repeat(2, 200px);
            gap: 20px;
            justify-content: center;
        }

        .btn {
            padding: 15px;
            font-size: 18px;
            background-color: black;
            color: #2dc84d;
            border: 2px solid #2dc84d;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: #2dc84d;
            color: black;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            text-align: center;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .content {
            margin: 40px;
        }

        .question-box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            display: block;
            width: 60%;
            margin-left: auto;
            margin-right: auto;
            font-size: 28px;
        }

        .answers {
            display: grid;
            grid-template-columns: repeat(2, 200px);
            gap: 20px;
            justify-content: center;
        }

        .btn {
            padding: 15px;
            font-size: 18px;
            background-color: white;
            color: black;
            border: 2px solid #e63973;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn:hover {
            background-color: #e63973;
            color: white;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">
        <h2>Answer as quickly as possible to avoid becoming a ghost!</h2>

        <div class="question-box">
            {{ question }}
        </div>

        <div class="answers">
            <button class="btn" onclick="checkAnswer('{{ option1 }}')">{{ option1 }}</button>
            <button class="btn" onclick="checkAnswer('{{ option2 }}')">{{ option2 }}</button>
            <button class="btn" onclick="checkAnswer('{{ option3 }}')">{{ option3 }}</button>
            <button class="btn" onclick="checkAnswer('{{ option4 }}')">{{ option4 }}</button>
        </div>
    </div>

    <script>
        function checkAnswer(selected) {
            const correct = "{{ correct_answer }}";
            if (selected === correct) {
                window.location.href = "/minigame-correct/{{ gameId }}";
            } else {
                window.location.href = "/minigame-incorrect/{{ gameId }}";
            }
        }
    </script>

    <script>
        const pollMinigame = setInterval(() => {
            fetch("/minigame-active/{{ gameId }}")
                .then(response => response.json())
                .then(data => {
                    if (!data.active) {
                        clearInterval(pollMinigame);
                        window.location.href = "/minigame-result/{{ gameId }}";
                    }
                })
                .catch(err => console.log("Poll error: " + err));
        }, 500);
    </script>
</body>
</html>