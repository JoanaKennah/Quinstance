<!DOCTYPE html>
<html lang="en">
<head>
    <title>Maths Incorrect Answer</title>

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2dc84d;
            text-align: center;
        }

        .navbar {
            background-color: #2dc84d;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .content {
            margin: 60px;
        }

        .title {
            font-size: 36px;
            margin-bottom: 30px;
        }

        .box {
            border: 2px solid #2dc84d;
            border-radius: 10px;
            padding: 25px;
            display: inline-block;
            margin-bottom: 30px;
            font-size: 20px;
            width: 60%;
            max-width: 600px;
        }

        .timer {
            font-size: 40px;
            font-weight: bold;
        }
    </style>

    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            text-align: center;
        }

        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .content {
            margin: 60px;
        }

        .title {
            font-size: 36px;
            margin-bottom: 30px;
        }

        .box {
            border: 2px solid #e63973;
            border-radius: 10px;
            padding: 25px;
            display: inline-block;
            margin-bottom: 30px;
            font-size: 20px;
            width: 60%;
            max-width: 600px;
        }

        .timer {
            font-size: 40px;
            font-weight: bold;
            color: #e63973;
        }
    </style>
    {% endif %}
</head>

<body>
    <div class="navbar">
        <a href="/home">Logout</a>
    </div>

    <div class="content">
        <div class="title">Oops!</div>

        <div class="box">
            That was incorrect, you have been temporarily stunned
        </div>

        <div class="timer" id="timer">3</div>
    </div>

    <script>
        let timeLeft = 3;
        const timerElement = document.getElementById("timer");

        const countdown = setInterval(() => {
            timeLeft--;
            timerElement.textContent = timeLeft;

            if (timeLeft <= 0) {
                clearInterval(countdown);
                window.location.href = "/mini_game_maths_question";
            }
        }, 1000);
    </script>
</body>
</html>