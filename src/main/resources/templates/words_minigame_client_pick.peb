<!DOCTYPE html>
<html lang="en">
<head>
    <title>Words</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
            color: #2DC84D;
        }

        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
            color: black;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: calc(100vh - 44px);
        }

        .card {
            border: 3px solid #2DC84D;
            border-radius: 20px;
            padding: 40px 60px;
            text-align: center;
        }

        .title {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .countdown {
            font-size: 48px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .grid {
            display: inline-grid;
            grid-template-columns: repeat(5, 52px);
            gap: 6px;
            margin-bottom: 24px;
        }

        .cell {
            width: 52px;
            height: 52px;
            border: 2px solid #2DC84D;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
        }

        .word-input {
            padding: 10px 16px;
            font-size: 18px;
            border: 2px solid #2DC84D;
            border-radius: 8px;
            background: black;
            color: #2DC84D;
            width: 240px;
            text-transform: uppercase;
        }

        .word-input::placeholder {
            color: #2DC84D;
            opacity: 0.5;
        }

        .btn-submit {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 14px;
            font-size: 16px;
            font-weight: bold;
            background-color: black;
            color: #2DC84D;
            border: 2px solid #2DC84D;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-submit:hover {
            background-color: #2DC84D;
            color: black;
        }

        .error {
            color: red;
            font-size: 14px;
            margin-top: 10px;
            min-height: 20px;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
        }

        .logout-btn {
            color: white;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            padding: 0;
        }

        .logout-btn:hover {
            text-decoration: underline;
        }

        .content {
            display: flex;
            justify-content: center;
            align-items: center;
            height: calc(100vh - 44px);
        }

        .card {
            border: 3px solid #d33469;
            border-radius: 20px;
            padding: 40px 60px;
            text-align: center;
        }

        .title {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .countdown {
            font-size: 48px;
            font-weight: bold;
            color: #d33469;
            margin-bottom: 20px;
        }

        .grid {
            display: inline-grid;
            grid-template-columns: repeat(5, 52px);
            gap: 6px;
            margin-bottom: 24px;
        }

        .cell {
            width: 52px;
            height: 52px;
            border: 2px solid #d33469;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: bold;
        }

        .word-input {
            padding: 10px 16px;
            font-size: 18px;
            border: 2px solid #d33469;
            border-radius: 8px;
            width: 240px;
            text-transform: uppercase;
        }

        .btn-submit {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 14px;
            font-size: 16px;
            font-weight: bold;
            background-color: white;
            color: black;
            border: 2px solid #d33469;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-submit:hover {
            background-color: #b02a57;
            color: white;
        }

        .error {
            color: red;
            font-size: 14px;
            margin-top: 10px;
            min-height: 20px;
        }
    </style>
    {% endif %}
</head>
<body>
    <div class="navbar">
        <a href="/quit-game" style="color: black; text-decoration: none; font-weight: bold;">Quit</a>
        <form method="post" action="/logout">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="content">
        <div class="card">
            <div class="title">Create a word with these letters!</div>
            <div class="countdown" id="timer">30</div>

            <div class="grid">
                {% for letter in grid %}
                    <div class="cell">{{ letter }}</div>
                {% endfor %}
            </div>

            <form id="word-form" method="post" action="/words-submit/{{ gameId }}">
                <input type="text" name="word" id="word-input" class="word-input" placeholder="Enter word here" autocomplete="off" required />
                <button type="submit" class="btn-submit">Submit</button>
            </form>

            <div class="error">{% if errorMessage %}{{ errorMessage }}{% endif %}</div>
        </div>
    </div>

   
    <script>
        const GAME_DURATION = 30;

        if (!sessionStorage.getItem("wordsStartTime_{{ gameId }}")) {
            sessionStorage.setItem("wordsStartTime_{{ gameId }}", Date.now().toString());
        }

        const startTime = parseInt(sessionStorage.getItem("wordsStartTime_{{ gameId }}"));
        const elapsedTime = Math.floor((Date.now() - startTime) / 1000);
        let timeLeft = Math.max(0, GAME_DURATION - elapsedTime);

        const timerDisplay = document.getElementById("timer");
        timerDisplay.textContent = timeLeft;

        const countdown = setInterval(() => {
            timeLeft--;
            timerDisplay.textContent = timeLeft;
            if (timeLeft <= 0) {
                clearInterval(countdown);
                sessionStorage.removeItem("wordsStartTime_{{ gameId }}");
                document.getElementById("word-form").submit();
            }
        }, 1000);

        const pollMinigame = setInterval(() => {
            fetch("/minigame-active/{{ gameId }}")
                .then(r => r.json())
                .then(data => {
                    if (!data.active) {
                        clearInterval(pollMinigame);
                        clearInterval(countdown);
                        window.location.href = "/words-result/{{ gameId }}";
                    }
                })
                .catch(err => console.log("Poll error: " + err));
        }, 500);
    </script>
   
</body>
</html>