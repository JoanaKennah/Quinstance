<!DOCTYPE html>
<html lang="en">
<head>
    <title>Game Night</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(#FFFFFF, #cfe2f3);
        }

        .navbar {
            background-color: #cfe2f3;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(#B0D0ED, #cfe2f3);
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }
      
        .navbar-right {
            display: flex;
            gap: 10px;
        }

        .logo-box {
            display: flex;
            align-items: center;
            padding: 0;
        }

        .logo-img {
            height: 44px;
            width: auto;
            display: block;
        }

        .site-name {
            color: #1a5276;
            font-weight: bold;
            font-size: 16px;
        }

        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .navbar a:hover {
            text-decoration: underline;
        }

        .main {
            padding: 30px 40px;
        }

        h1 {
            text-align: center;
            font-weight: bold;
            font-size: 3em;
            color: black;
            margin-bottom: 30px;
        }

        .section-title {
            font-weight: bold;
            font-size: 1.5em;
            text-align: center;
            color: black;
            margin-bottom: 8px;
        }
      
        .columns {
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }

        .column {
            flex: 1;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>

<body>
    <div class="navbar">
        <div class="navbar-left">
            <div class="logo-box">
                <svg class="logo-img" viewBox="0 0 1140 1140" xmlns="http://www.w3.org/2000/svg" aria-label="Game Night logo" role="img">
                    <circle cx="570" cy="570" r="520" fill="none" stroke="#7FC87F" stroke-width="40"/>
                    <path fill="#7FC87F" fill-rule="evenodd"
                          d="M 570 180 C 410 180 300 320 300 500 C 275 680 215 820 240 920 Q 320 965 410 935 Q 475 975 540 925 Q 610 970 675 915 Q 740 960 810 900 C 825 750 840 600 840 500 C 840 320 730 180 570 180 Z M 570 230 C 425 230 350 340 350 510 C 330 680 285 800 295 900 Q 365 940 440 915 Q 500 945 555 910 Q 615 940 670 910 Q 720 930 760 905 C 775 750 790 600 790 510 C 790 340 715 230 570 230 Z"/>
                    <circle cx="500" cy="480" r="30" fill="#7FC87F"/>
                    <circle cx="640" cy="480" r="30" fill="#7FC87F"/>
                    <ellipse cx="570" cy="580" rx="30" ry="42" fill="#7FC87F"/>
                </svg>
            </div>
            <span class="site-name">Game Night</span>
        </div>
        <div class="navbar-right">
            <a href="/home">Home</a>
        </div>
    </div>

    <main class="main">
        <h1>How to Play!</h1>
      
        <div class="columns">
            <div class="column">
                <h2 class="section-title">Quizzes:</h2>
                <p>Text</p>
            </div>

            <div class="column">
                <h2 class="section-title">Minigames:</h2>
                <p>Text</p>
            </div>

            <div class="column">
                <h2 class="section-title">Being a Ghost:</h2>
                <p>Text</p>
            </div>
        </div>
    </main>

</body>
</html>
