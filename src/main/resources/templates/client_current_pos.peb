<!DOCTYPE html>
<html lang="en">
<head>
    <title>Position</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if theme == "spooky" %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: black;
        }
        .navbar {
            background-color: #2DC84D;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }
        .content {
            margin: 40px;
            text-align: center;
        }
        .title {
            font-size: 28px;
            color: #2DC84D;
            margin-bottom: 20px;
        }
        .position {
            font-size: 36px;
            font-weight: bold;
            color: #2DC84D;
            margin-bottom: 10px;
        }
        .out-of {
            color: #2DC84D;
            font-size: 18px;
            margin-bottom: 30px;
        }
        .score-title {
            font-size: 22px;
            color: #2DC84D;
            margin-bottom: 10px;
        }
        .score {
            font-size: 36px;
            font-weight: bold;
            color: #2DC84D;
        }
    </style>
    {% else %}
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }
      
        .navbar {
            background-color: #d33469;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title {
            font-size: 28px;
            color: black;
            margin-bottom: 20px;
        }

        .position {
            font-size: 36px;
            font-weight: bold;
            color: black;
            margin-bottom: 10px;
        }

        .out-of {
            color: #d33469;
            font-size: 18px;
            margin-bottom: 30px;
        }

        .score-title {
            font-size: 22px;
            color: black;
            margin-bottom: 10px;
        }

        .score {
            font-size: 36px;
            font-weight: bold;
            color: black;
        }

        .timer {
            margin-top: 30px;
            font-size: 18px;
            color: #d33469;
        }
    </style>
    {% endif %}

    <script>
        //polls for next Q
        const currentIndex = {{ questionIndex }};

        const pollSend = setInterval(() => {
            fetch("/question-index/{{ gameId }}")
            .then(response => response.json())
            .then(data => {
                if (data.finished) {
                    clearInterval(pollSend);
                    clearInterval(kickPoll);
                    window.location.href = "/end-game/{{ gameId }}";
                } else if (data.index > currentIndex) {
                    clearInterval(pollSend);
                    clearInterval(kickPoll);
                    window.location.href = "/game/{{ gameId }}";
                }
            })
            .catch(err => console.log("Polling error: " + err));
        }, 500);

        //polls to check if player kicked
        const kickPoll = setInterval(() => {
            fetch("/is-kicked/{{ gameId }}")
                .then(response => response.json())
                .then(data => {
                    if (data.kicked) {
                        clearInterval(kickPoll);
                        clearInterval(pollSend);
                        window.location.href = "/kicked/{{ gameId }}";
                    }
                })
                .catch(err => console.log("Kick poll error: " + err));
        }, 1000);
    </script>

</head>

<body>
  
<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="title">
        You are currently:
    </div>
    <div class="position">
        {{ position }}
    </div>

    <div class="out-of">
        Out of {{ totalPlayers }}
    </div>

    <div class="score-title">
        Total Score:
    </div>
    <div class="score">
        {{ score }}
    </div>

</div>

</body>
</html>