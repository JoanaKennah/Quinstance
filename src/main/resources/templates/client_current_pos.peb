<!DOCTYPE html>
<html lang="en">
<head>
    <title>Position</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }
      
        .navbar {
            background-color: #e63973;
            display: flex;
            justify-content: flex-end;
            padding: 12px 20px;
        }
      
        .navbar a {
            color: black;
            text-decoration: none;
            font-weight: bold;
        }

        .content {
            margin: 40px;
            text-align: center;
        }

        .title {
            font-size: 28px;
            color: black;
            margin-bottom: 20px;
        }

        .position {
            font-size: 36px;
            font-weight: bold;
            color: black;
            margin-bottom: 10px;
        }

        .out-of {
            color: #e63973;
            font-size: 18px;
            margin-bottom: 30px;
        }

        .score-title {
            font-size: 22px;
            color: black;
            margin-bottom: 10px;
        }

        .score {
            font-size: 36px;
            font-weight: bold;
            color: black;
        }

        .timer {
            margin-top: 30px;
            font-size: 18px;
            color: #e63973
        }

    </style>

    <script>
        //set 10 sec timer then advance
        let timeLeft = 10;

        function startTimer() {
            const timerDisplay = document.getElementById("countdown");
            const countdown = setInterval(() => {
                timeLeft--;
                timerDisplay.textContent = timeLeft;
                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    //when timer expires post to next Q
                    fetch("/next-question/{{ gameId }}", { method: "POST" })
                        .then(() => window.location.href = "/game/{{ gameId }}");
                }
            } , 1000);
        }

        window.onload = startTimer;
    </script>

</head>

<body>
  
<div class="navbar">
    <a>{{ quizName }}</a>
</div>

<div class="content">

    <div class="title">
        You are currently:
    </div>
    <div class="position">
        {{ position }}
    </div>

    <div class="out-of">
        Out of {{ totalPlayers }}
    </div>

    <div class="score-title">
        Total Score:
    </div>
    <div class="score">
        {{ score }}
    </div>

    <div class="timer">
        Next question in <span id="countdown">10</span> seconds...
    </div>

</div>

</body>
</html>